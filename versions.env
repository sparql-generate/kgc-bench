RML_LV_REPO=https://github.com/kg-construct/rml-lv.git
RML_LV_COMMIT=94beb945e5f30d019fae781d0119d00fa472155f

# The RML -> SPARQL-Generate translator (a SPARQL-Generate query)
RML2SG_REPO=https://github.com/sparql-generate/rml-to-sparql-generate.git
RML2SG_COMMIT=5fa291a
# the direct translation, before the rewritings (engines *-translated-tau)
RML2SG_TAU_COMMIT=bf5ddcc

# Workloads
GTFS_BENCH_REPO=https://github.com/oeg-upm/gtfs-bench.git
GTFS_BENCH_COMMIT=7fcdaa7456ef506d9eb2d7354550d35eb0209932

# Engines (released artefacts)
# SPARQL-Generate under test (sg-java): the GitHub release asset, checksum verified
SPARQL_GENERATE_VERSION=2.5.0
SPARQL_GENERATE_URL=https://github.com/sparql-generate/sparql-generate/releases/download/v2.5.0/sparql-generate-2.5.0.jar
SPARQL_GENERATE_SHA256=ea275f0bd1a0bf0169c7c913544478942280b5848dcd3643aed03a0a5f233dbd
# the last release before the 2026 revival (sg-java-2.1.0)
SPARQL_GENERATE_RELEASE=2.1.0
SPARQL_GENERATE_RELEASE_URL=https://github.com/sparql-generate/sparql-generate/releases/download/2.1.0/sparql-generate-2.1.0.jar
RMLMAPPER_VERSION=8.1.0
RMLMAPPER_URL=https://github.com/RMLio/rmlmapper-java/releases/download/v8.1.0/rmlmapper-8.1.0-r380-all.jar
SPARQL_ANYTHING_VERSION=1.3.0
SPARQL_ANYTHING_URL=https://github.com/SPARQL-Anything/sparql.anything/releases/download/v1.3.0/sparql-anything-v1.3.0.jar
MORPH_KGC_VERSION=2.10.0
SDM_RDFIZER_VERSION=4.7.5.15.4.1

# Java runtime used for every Java engine (RMLMapper 8 needs >= 21)
JAVA_HOME_BENCH=/usr/lib/jvm/java-21-openjdk-amd64
# JDK used to build SPARQL-Generate from ../sparql-generate (KGC_BENCH_SG_JAR=head; Java >= 17)
JAVA_HOME_BUILD=/usr/lib/jvm/java-21-openjdk-amd64
# RDF Processing Toolkit (C. Stadler): RML -> SPARQL CONSTRUCT translator + Jena ARQ
RPT_VERSION=2.0.0-rc7
RPT_URL=https://github.com/Scaseco/RdfProcessingToolkit/releases/download/v2.0.0-rc7/rpt-2.0.0-rc7.jar
# KGCW Challenge 2024 (kg-construct/challenge-tool), Zenodo record 10973433
KGCW_2024_URL=https://zenodo.org/record/10973433/files/challenge.tar.gz?download=1
KGCW_2024_SIZE=4526319566

# Positioning scenarios (positioning/): plain SPARQL engines that SPARQL Anything
# queries are run on (portability). Oxigraph is the pyoxigraph that Morph-KGC pins.
JENA_VERSION=5.6.0
