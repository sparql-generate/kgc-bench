# Pinned third-party artefacts. Sourced by scripts/*.sh, read by harness/__init__.py.
# Changing a value here changes what the benchmark measures: commit it with the results.

# Test suites
RML_TEST_CASES_REPO=https://github.com/RMLio/rml-test-cases.git
RML_TEST_CASES_COMMIT=803dd3ec6b7185801cf19ebecaa18513baf78613
RML_CORE_REPO=https://github.com/kg-construct/rml-core.git
RML_CORE_COMMIT=82ab28d46803ba66a83c133f1db371a60116f84d
# the test cases of the RML modules (W3C KG-Construct CG), heads of main on 2026-11-22
RML_IO_REPO=https://github.com/kg-construct/rml-io.git
RML_IO_COMMIT=0cb26a245ca700d05d98bd1b6c3b88831cab5c2c
RML_FNML_REPO=https://github.com/kg-construct/rml-fnml.git
RML_FNML_COMMIT=f573f7985cdda8d12db1df2bb5ff2a0209f6e43e
RML_CC_REPO=https://github.com/kg-construct/rml-cc.git
RML_CC_COMMIT=d97fddf0f769f352d256a96b93544f3dfd192ffc
RML_STAR_REPO=https://github.com/kg-construct/rml-star.git
RML_STAR_COMMIT=9517932a7854e84fe0bc6c85b98ac19008748f77
RML_LV_REPO=https://github.com/kg-construct/rml-lv.git
RML_LV_COMMIT=94beb945e5f30d019fae781d0119d00fa472155f

# The RML -> SPARQL-Generate translator (a SPARQL-Generate query)
RML2SG_REPO=https://github.com/sparql-generate/rml-to-sparql-generate.git
# release 0.5.4 (tag v0.5.4, DOI 10.5281/zenodo.24629645): joins on several conditions compared as one
# composite key, looked up at once (R8 and R9 on several join columns, joins of logical views); a translation
# time that grows with the mapping, not its square (gtfs-feeds, 1 300 triples maps: over 600 s to about 75 s).
# 0.5.2: rewritings R8 and R9 (joins without the graph of the child keys), RML-LV joins in linear time
RML2SG_COMMIT=d81cdee569a0b8cfaec66bb076b02425938f0862
# the direct translation, before the rewritings (engines *-translated-tau)
RML2SG_TAU_COMMIT=bf5ddcc

# Workloads
GTFS_BENCH_REPO=https://github.com/oeg-upm/gtfs-bench.git
GTFS_BENCH_COMMIT=7fcdaa7456ef506d9eb2d7354550d35eb0209932

# Engines (released artefacts)
# SPARQL-Generate under test (sg-java): the GitHub release asset, checksum verified
# (2.6.3: DOI 10.5281/zenodo.24621862)
SPARQL_GENERATE_VERSION=2.6.3
SPARQL_GENERATE_URL=https://github.com/sparql-generate/sparql-generate/releases/download/v2.6.3/sparql-generate-2.6.3.jar
SPARQL_GENERATE_SHA256=a77e0f147e6092b33b7c8ef9624a97e2806bdeaaadbec8762975ea6e6e402850
# pysparql-generate under test: release 0.4.2 (PyPI; tag v0.4.2, DOI 10.5281/zenodo.24615614),
# the commit exported by scripts/build_pysparql_generate.sh
PYSPARQL_GENERATE_REPO=https://github.com/sparql-generate/pysparql-generate.git
PYSPARQL_GENERATE_VERSION=0.4.2
PYSPARQL_GENERATE_COMMIT=8d6d779afe
# the last release before the 2026 revival (sg-java-2.1.0)
SPARQL_GENERATE_RELEASE=2.1.0
SPARQL_GENERATE_RELEASE_URL=https://github.com/sparql-generate/sparql-generate/releases/download/2.1.0/sparql-generate-2.1.0.jar
RMLMAPPER_VERSION=8.1.0
RMLMAPPER_URL=https://github.com/RMLio/rmlmapper-java/releases/download/v8.1.0/rmlmapper-8.1.0-r380-all.jar
SPARQL_ANYTHING_VERSION=1.3.0
SPARQL_ANYTHING_URL=https://github.com/SPARQL-Anything/sparql.anything/releases/download/v1.3.0/sparql-anything-v1.3.0.jar
MORPH_KGC_VERSION=2.10.0
SDM_RDFIZER_VERSION=4.7.5.15.4.1

# RML engines added on 2026-11-26 (conformance and performance)
# RocketRML (Node.js library, no command line): npm package, installed with npm ci from
# scripts/rocketrml/package-lock.json (integrity hashes), run by scripts/rocketrml/rocketrml.js
ROCKETRML_VERSION=3.0.0
# on Node.js 20: on Node.js 22 its dependency jsonld 5 fails to load (package esm:
# "Function.prototype.apply was called on undefined"); the official Node.js binary, checksum
# from https://nodejs.org/dist/v20.20.0/SHASUMS256.txt
NODE_VERSION=20.20.0
NODE_URL=https://nodejs.org/dist/v20.20.0/node-v20.20.0-linux-x64.tar.xz
NODE_SHA256=4f48b52acf42130844a3a75e94da0e9629009d09e4101b2304895c24f3fbe609
# FlexRML (C++): the prebuilt Linux x86-64 binary of the GitHub release
FLEXRML_VERSION=3.1.0
FLEXRML_URL=https://github.com/wintechis/flex-rml/releases/download/3.1.0/flexrml-3.1.0.linux-x86_64
FLEXRML_SHA256=27b2e52a8967e464eb8fb0aa822f45979c7674dea71ed324aff10ab2bd21bf87
# BURP (Java), the processor of the W3C KG-Construct CG modules: GitHub release asset
BURP_VERSION=0.1.3
BURP_URL=https://github.com/kg-construct/BURP/releases/download/v0.1.3/burp.jar
BURP_SHA256=08afed456b86c037b785d058f1543e41335671426c983b1200b97ab0ec936f83
# RMLStreamer (Scala, Apache Flink): the standalone jar (embedded local Flink, no cluster);
# on JDK 11 (JAVA_HOME_RMLSTREAMER): Flink 1.14 supports Java 8 and 11 only, and on JDK 21
# its Kryo serialiser fails ("module java.base does not opens java.util")
RMLSTREAMER_VERSION=2.5.0
RMLSTREAMER_URL=https://github.com/RMLio/RMLStreamer/releases/download/v2.5.0/RMLStreamer-v2.5.0-standalone.jar
RMLSTREAMER_SHA256=67625a1000ba2f532c597caef008c5ca068d1ed67adb85c2518d34c59d027607

# RDFC-1.0 (W3C RDF Dataset Canonicalization) for the fingerprint of an output with blank
# nodes: rdf-canonize (Digital Bazaar; in the W3C implementation report of RDFC-1.0), npm
# tarball checksum below, installed with npm ci (scripts/rdfc/package-lock.json) on NODE_VERSION
RDF_CANONIZE_VERSION=5.0.0
RDF_CANONIZE_URL=https://registry.npmjs.org/rdf-canonize/-/rdf-canonize-5.0.0.tgz
RDF_CANONIZE_SHA256=ad8ef5d1a3400a152668de5f3ab4611b1b3b2347bb237542cd8e3c7835707f7a

# Engines with their own mapping language (performance only, GTFS mapping in workloads/gtfs/)
SHEXML_VERSION=0.7.1
SHEXML_URL=https://github.com/herminiogg/ShExML/releases/download/v0.7.1/ShExML-v0.7.1.jar
SHEXML_SHA256=43750ea8feccd1b8072b490d52aa3be3ea22229d93fecf08803e06f4f380c9ca
# D-REPR (PyPI drepr 2.11.2) is not included: README, "Engines not included"

# Local databases of the SQL conformance cases (harness.database, Docker), pinned by digest
# (postgres:16.6-alpine, mysql:8.0.40; SQL Server 2022 CU16, Express edition, ACCEPT_EULA=Y:
# the licence accepted by the benchmark's owner)
POSTGRES_IMAGE=postgres@sha256:1d04b9ba1d4996401f2552b51beda8187f175c0645c091e4781134fc9c9a3eef
MYSQL_IMAGE=mysql@sha256:d58ac93387f644e4e040c636b8f50494e78e5afc27ca0a87348b2f577da2b7ff
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server@sha256:45a1a9d13ca5574cf8e0fe4ae73ab77248b66d9c3132ac9658fb6c16dd72a8af

# Java runtime used for every Java engine (RMLMapper 8 needs >= 21)
JAVA_HOME_BENCH=/usr/lib/jvm/java-21-openjdk-amd64
# RMLStreamer 2.5.0 (Flink 1.14) runs on Java 8 or 11 only
JAVA_HOME_RMLSTREAMER=/usr/lib/jvm/java-11-openjdk-amd64
# JDK used to build SPARQL-Generate from ../sparql-generate (KGC_BENCH_SG_JAR=head; Java >= 17)
JAVA_HOME_BUILD=/usr/lib/jvm/java-21-openjdk-amd64
# RDF Processing Toolkit (C. Stadler): RML -> SPARQL CONSTRUCT translator + Jena ARQ
RPT_VERSION=2.0.0-rc7
RPT_URL=https://github.com/Scaseco/RdfProcessingToolkit/releases/download/v2.0.0-rc7/rpt-2.0.0-rc7.jar
# KGCW Challenge 2024 (kg-construct/challenge-tool), Zenodo record 10973433
KGCW_2024_URL=https://zenodo.org/record/10973433/files/challenge.tar.gz?download=1
KGCW_2024_SIZE=4526319566

# Positioning scenarios (positioning/): plain SPARQL engines that SPARQL Anything
