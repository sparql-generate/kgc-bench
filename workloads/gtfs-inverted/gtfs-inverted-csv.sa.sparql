# generated by scripts/gtfs_mappings.py from gtfs-csv.rml.ttl (GTFS-Madrid-Bench): do not edit
# GTFS-Madrid-Bench, CSV distribution: the SPARQL Anything (Facade-X)
# counterpart of gtfs-inverted-csv.rml.ttl (the GTFS mapping, its
# IRI-valued branches inverted). %DATA% is
# replaced by the directory of the data. Same semantics as the RML mapping:
# an empty cell is null (filtered out: the facade holds it as ""; the option
# csv.null-string cannot be given the empty string), IRI values are
# percent-encoded,
# a referencing object exists only if its parent row exists: the child key
# is bound first (a missing value replaced by a string that no key equals),
# then looked up in the parent.
PREFIX inv:    <http://transport.linkeddata.es/inverse/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX gtfs:   <http://vocab.gtfs.org/terms#>
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX geo:    <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX schema: <http://schema.org/>

CONSTRUCT {
  ?agency a gtfs:Agency ; foaf:name ?agency_name ; gtfs:timeZone ?agency_timezone ; dct:language ?agency_lang ; foaf:phone ?agency_phone .
  ?route a gtfs:Route ; gtfs:shortName ?route_short_name ; gtfs:longName ?route_long_name ; dct:description ?route_desc ; gtfs:color ?route_color ; gtfs:textColor ?route_text_color .
  ?stop a gtfs:Stop ; gtfs:code ?stop_code ; dct:identifier ?stop_id ; foaf:name ?stop_name ; dct:description ?stop_desc ; geo:lat ?stop_lat_d ; geo:long ?stop_lon_d ; gtfs:zone ?zone_id ; gtfs:timeZone ?stop_timezone .
  ?service1 a gtfs:Service .
  ?calendar_rule a gtfs:CalendarRule ; gtfs:monday ?mo ; gtfs:tuesday ?tu ; gtfs:wednesday ?we ; gtfs:thursday ?th ; gtfs:friday ?fr ; gtfs:saturday ?sa ; gtfs:sunday ?su ; schema:startDate ?cal_start ; schema:endDate ?cal_end .
  ?service2 a gtfs:Service .
  ?date_rule a gtfs:CalendarDateRule ; dct:date ?cd_date ; gtfs:dateAddition ?cd_addition .
  ?shape a gtfs:Shape .
  ?shape_point a gtfs:ShapePoint ; geo:lat ?sh_lat ; geo:long ?sh_lon ; gtfs:pointSequence ?shape_pt_sequence ; gtfs:distanceTraveled ?sh_dist .
  ?trip a gtfs:Trip ; gtfs:headsign ?trip_headsign ; gtfs:shortName ?trip_short_name ; gtfs:direction ?direction_id ; gtfs:block ?block_id .
  ?stoptime a gtfs:StopTime ; gtfs:arrivalTime ?arrival_time ; gtfs:departureTime ?departure_time ; gtfs:stopSequence ?st_seq ; gtfs:headsign ?stop_headsign ; gtfs:distanceTraveled ?st_dist .
  ?frequency a gtfs:Frequency ; gtfs:startTime ?start_time ; gtfs:endTime ?end_time ; gtfs:headwaySeconds ?headway ; gtfs:exactTimes ?exact .
  ?feed a gtfs:Feed ; dct:publisher ?feed_publisher_name ; dct:language ?feed_lang ; schema:startDate ?feed_start ; schema:endDate ?feed_end ; schema:version ?feed_version .
  # the inverted branches
  ?agency_page inv:page ?agency .
  ?agency_fare inv:fareUrl ?agency .
  ?route_type_iri inv:routeType ?route .
  ?route_page inv:routeUrl ?route .
  ?route_agency inv:agency ?route .
  ?stop_page inv:page ?stop .
  ?location_type_iri inv:locationType ?stop .
  ?wheelchair_boarding_iri inv:wheelchairAccessible ?stop .
  ?parent inv:parentStation ?stop .
  ?calendar_rule inv:serviceRule ?service1 .
  ?date_rule inv:serviceRule ?service2 .
  ?shape_point inv:shapePoint ?shape .
  ?wheelchair_accessible_iri inv:wheelchairAccessible ?trip .
  ?trip_service1 inv:service ?trip .
  ?trip_service2 inv:service ?trip .
  ?trip_route inv:route ?trip .
  ?trip_shape inv:shape ?trip .
  ?pickup_iri inv:pickupType ?stoptime .
  ?dropoff_iri inv:dropOffType ?stoptime .
  ?st_trip inv:trip ?stoptime .
  ?st_stop inv:stop ?stoptime .
  ?fq_trip inv:trip ?frequency .
  ?feed_page inv:page ?feed .
}
WHERE {
  {
    SERVICE <x-sparql-anything:location=%DATA%/AGENCY.csv,csv.headers=true> {
      ?r xyz:agency_id ?agency_id .
      OPTIONAL { ?r xyz:agency_name ?agency_name FILTER(?agency_name != "") } OPTIONAL { ?r xyz:agency_url ?agency_url FILTER(?agency_url != "") }
      OPTIONAL { ?r xyz:agency_timezone ?agency_timezone FILTER(?agency_timezone != "") } OPTIONAL { ?r xyz:agency_lang ?agency_lang FILTER(?agency_lang != "") }
      OPTIONAL { ?r xyz:agency_phone ?agency_phone FILTER(?agency_phone != "") } OPTIONAL { ?r xyz:agency_fare_url ?agency_fare_url FILTER(?agency_fare_url != "") }
    }
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/agency/", ENCODE_FOR_URI(?agency_id))) AS ?agency)
    BIND(IRI(?agency_url) AS ?agency_page) BIND(IRI(?agency_fare_url) AS ?agency_fare)
  } UNION {
    SERVICE <x-sparql-anything:location=%DATA%/ROUTES.csv,csv.headers=true> {
      ?r xyz:route_id ?route_id .
      OPTIONAL { ?r xyz:agency_id ?r_agency_id FILTER(?r_agency_id != "") } OPTIONAL { ?r xyz:route_short_name ?route_short_name FILTER(?route_short_name != "") }
      OPTIONAL { ?r xyz:route_long_name ?route_long_name FILTER(?route_long_name != "") } OPTIONAL { ?r xyz:route_desc ?route_desc FILTER(?route_desc != "") }
      OPTIONAL { ?r xyz:route_type ?route_type FILTER(?route_type != "") } OPTIONAL { ?r xyz:route_url ?route_url FILTER(?route_url != "") }
      OPTIONAL { ?r xyz:route_color ?route_color FILTER(?route_color != "") } OPTIONAL { ?r xyz:route_text_color ?route_text_color FILTER(?route_text_color != "") }
    }
    BIND(COALESCE(?r_agency_id, "urn:x-kgc-bench:null") AS ?r_agency_id_k)
    OPTIONAL {
      SERVICE <x-sparql-anything:location=%DATA%/AGENCY.csv,csv.headers=true> { ?a xyz:agency_id ?r_agency_id_k }
      BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/agency/", ENCODE_FOR_URI(?r_agency_id_k))) AS ?route_agency)
    }
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/routes/", ENCODE_FOR_URI(?route_id))) AS ?route)
    BIND(IRI(CONCAT("http://transport.linkeddata.es/resource/RouteType/", ENCODE_FOR_URI(?route_type))) AS ?route_type_iri)
    BIND(IRI(?route_url) AS ?route_page)
  } UNION {
    SERVICE <x-sparql-anything:location=%DATA%/STOPS.csv,csv.headers=true> {
      ?r xyz:stop_id ?stop_id .
      OPTIONAL { ?r xyz:stop_code ?stop_code FILTER(?stop_code != "") } OPTIONAL { ?r xyz:stop_name ?stop_name FILTER(?stop_name != "") }
      OPTIONAL { ?r xyz:stop_desc ?stop_desc FILTER(?stop_desc != "") } OPTIONAL { ?r xyz:stop_lat ?stop_lat FILTER(?stop_lat != "") }
      OPTIONAL { ?r xyz:stop_lon ?stop_lon FILTER(?stop_lon != "") } OPTIONAL { ?r xyz:zone_id ?zone_id FILTER(?zone_id != "") }
      OPTIONAL { ?r xyz:stop_url ?stop_url FILTER(?stop_url != "") } OPTIONAL { ?r xyz:location_type ?location_type FILTER(?location_type != "") }
      OPTIONAL { ?r xyz:parent_station ?parent_station FILTER(?parent_station != "") } OPTIONAL { ?r xyz:stop_timezone ?stop_timezone FILTER(?stop_timezone != "") }
      OPTIONAL { ?r xyz:wheelchair_boarding ?wheelchair_boarding FILTER(?wheelchair_boarding != "") }
    }
    BIND(COALESCE(?parent_station, "urn:x-kgc-bench:null") AS ?parent_station_k)
    OPTIONAL {
      SERVICE <x-sparql-anything:location=%DATA%/STOPS.csv,csv.headers=true> { ?p xyz:stop_id ?parent_station_k }
      BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/stops/", ENCODE_FOR_URI(?parent_station_k))) AS ?parent)
    }
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/stops/", ENCODE_FOR_URI(?stop_id))) AS ?stop)
    BIND(STRDT(?stop_lat, xsd:double) AS ?stop_lat_d) BIND(STRDT(?stop_lon, xsd:double) AS ?stop_lon_d)
    BIND(IRI(?stop_url) AS ?stop_page)
    BIND(IRI(CONCAT("http://transport.linkeddata.es/resource/LocationType/", ENCODE_FOR_URI(?location_type))) AS ?location_type_iri)
    BIND(IRI(CONCAT("http://transport.linkeddata.es/resource/WheelchairBoardingStatus/", ENCODE_FOR_URI(?wheelchair_boarding))) AS ?wheelchair_boarding_iri)
  } UNION {
    SERVICE <x-sparql-anything:location=%DATA%/CALENDAR.csv,csv.headers=true> {
      ?r xyz:service_id ?service_id .
      OPTIONAL { ?r xyz:monday ?monday FILTER(?monday != "") } OPTIONAL { ?r xyz:tuesday ?tuesday FILTER(?tuesday != "") } OPTIONAL { ?r xyz:wednesday ?wednesday FILTER(?wednesday != "") }
      OPTIONAL { ?r xyz:thursday ?thursday FILTER(?thursday != "") } OPTIONAL { ?r xyz:friday ?friday FILTER(?friday != "") } OPTIONAL { ?r xyz:saturday ?saturday FILTER(?saturday != "") }
      OPTIONAL { ?r xyz:sunday ?sunday FILTER(?sunday != "") } OPTIONAL { ?r xyz:start_date ?start_date FILTER(?start_date != "") } OPTIONAL { ?r xyz:end_date ?end_date FILTER(?end_date != "") }
    }
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/services/", ENCODE_FOR_URI(?service_id))) AS ?service1)
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/calendar_rules/", ENCODE_FOR_URI(?service_id))) AS ?calendar_rule)
    BIND(STRDT(?monday, xsd:boolean) AS ?mo) BIND(STRDT(?tuesday, xsd:boolean) AS ?tu)
    BIND(STRDT(?wednesday, xsd:boolean) AS ?we) BIND(STRDT(?thursday, xsd:boolean) AS ?th)
    BIND(STRDT(?friday, xsd:boolean) AS ?fr) BIND(STRDT(?saturday, xsd:boolean) AS ?sa)
    BIND(STRDT(?sunday, xsd:boolean) AS ?su)
    BIND(STRDT(?start_date, xsd:date) AS ?cal_start) BIND(STRDT(?end_date, xsd:date) AS ?cal_end)
  } UNION {
    SERVICE <x-sparql-anything:location=%DATA%/CALENDAR_DATES.csv,csv.headers=true> {
      ?r xyz:service_id ?cd_service_id .
      OPTIONAL { ?r xyz:date ?date FILTER(?date != "") } OPTIONAL { ?r xyz:exception_type ?exception_type FILTER(?exception_type != "") }
    }
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/services/", ENCODE_FOR_URI(?cd_service_id))) AS ?service2)
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/calendar_date_rule/", ENCODE_FOR_URI(?cd_service_id), "-", ENCODE_FOR_URI(?date))) AS ?date_rule)
    BIND(STRDT(?date, xsd:date) AS ?cd_date) BIND(STRDT(?exception_type, xsd:boolean) AS ?cd_addition)
  } UNION {
    SERVICE <x-sparql-anything:location=%DATA%/SHAPES.csv,csv.headers=true> {
      ?r xyz:shape_id ?shape_id .
      OPTIONAL { ?r xyz:shape_pt_lat ?shape_pt_lat FILTER(?shape_pt_lat != "") } OPTIONAL { ?r xyz:shape_pt_lon ?shape_pt_lon FILTER(?shape_pt_lon != "") }
      OPTIONAL { ?r xyz:shape_pt_sequence ?shape_pt_sequence FILTER(?shape_pt_sequence != "") } OPTIONAL { ?r xyz:shape_dist_traveled ?shape_dist_traveled FILTER(?shape_dist_traveled != "") }
    }
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/shape/", ENCODE_FOR_URI(?shape_id))) AS ?shape)
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/shape_point/", ENCODE_FOR_URI(?shape_id), "-", ENCODE_FOR_URI(?shape_pt_sequence))) AS ?shape_point)
    BIND(STRDT(?shape_pt_lat, xsd:double) AS ?sh_lat) BIND(STRDT(?shape_pt_lon, xsd:double) AS ?sh_lon)
    BIND(STRDT(?shape_dist_traveled, xsd:double) AS ?sh_dist)
  } UNION {
    SERVICE <x-sparql-anything:location=%DATA%/TRIPS.csv,csv.headers=true> {
      ?r xyz:trip_id ?trip_id .
      OPTIONAL { ?r xyz:route_id ?t_route_id FILTER(?t_route_id != "") } OPTIONAL { ?r xyz:service_id ?t_service_id FILTER(?t_service_id != "") }
      OPTIONAL { ?r xyz:trip_headsign ?trip_headsign FILTER(?trip_headsign != "") } OPTIONAL { ?r xyz:trip_short_name ?trip_short_name FILTER(?trip_short_name != "") }
      OPTIONAL { ?r xyz:direction_id ?direction_id FILTER(?direction_id != "") } OPTIONAL { ?r xyz:block_id ?block_id FILTER(?block_id != "") }
      OPTIONAL { ?r xyz:shape_id ?t_shape_id FILTER(?t_shape_id != "") } OPTIONAL { ?r xyz:wheelchair_accessible ?wheelchair_accessible FILTER(?wheelchair_accessible != "") }
    }
    BIND(COALESCE(?t_service_id, "urn:x-kgc-bench:null") AS ?t_service_id_k)
    OPTIONAL {
      SERVICE <x-sparql-anything:location=%DATA%/CALENDAR.csv,csv.headers=true> { ?c xyz:service_id ?t_service_id_k }
      BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/services/", ENCODE_FOR_URI(?t_service_id_k))) AS ?trip_service1)
    }
    OPTIONAL {
      SELECT DISTINCT ?t_service_id_k ?trip_service2 WHERE {
        SERVICE <x-sparql-anything:location=%DATA%/CALENDAR_DATES.csv,csv.headers=true> { ?d xyz:service_id ?t_service_id_k }
        BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/services/", ENCODE_FOR_URI(?t_service_id_k))) AS ?trip_service2)
      }
    }
    BIND(COALESCE(?t_route_id, "urn:x-kgc-bench:null") AS ?t_route_id_k)
    OPTIONAL {
      SERVICE <x-sparql-anything:location=%DATA%/ROUTES.csv,csv.headers=true> { ?o xyz:route_id ?t_route_id_k }
      BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/routes/", ENCODE_FOR_URI(?t_route_id_k))) AS ?trip_route)
    }
    BIND(COALESCE(?t_shape_id, "urn:x-kgc-bench:null") AS ?t_shape_id_k)
    OPTIONAL {
      SELECT DISTINCT ?t_shape_id_k ?trip_shape WHERE {
        SERVICE <x-sparql-anything:location=%DATA%/SHAPES.csv,csv.headers=true> { ?h xyz:shape_id ?t_shape_id_k }
        BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/shape/", ENCODE_FOR_URI(?t_shape_id_k))) AS ?trip_shape)
      }
    }
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/trips/", ENCODE_FOR_URI(?trip_id))) AS ?trip)
    BIND(IRI(CONCAT("http://transport.linkeddata.es/resource/WheelchairBoardingStatus/", ENCODE_FOR_URI(?wheelchair_accessible))) AS ?wheelchair_accessible_iri)
  } UNION {
    SERVICE <x-sparql-anything:location=%DATA%/STOP_TIMES.csv,csv.headers=true> {
      ?r xyz:trip_id ?st_trip_id .
      OPTIONAL { ?r xyz:arrival_time ?arrival_time FILTER(?arrival_time != "") } OPTIONAL { ?r xyz:departure_time ?departure_time FILTER(?departure_time != "") }
      OPTIONAL { ?r xyz:stop_id ?st_stop_id FILTER(?st_stop_id != "") } OPTIONAL { ?r xyz:stop_sequence ?stop_sequence FILTER(?stop_sequence != "") }
      OPTIONAL { ?r xyz:stop_headsign ?stop_headsign FILTER(?stop_headsign != "") } OPTIONAL { ?r xyz:pickup_type ?pickup_type FILTER(?pickup_type != "") }
      OPTIONAL { ?r xyz:drop_off_type ?drop_off_type FILTER(?drop_off_type != "") } OPTIONAL { ?r xyz:shape_dist_traveled ?st_shape_dist FILTER(?st_shape_dist != "") }
    }
    BIND(COALESCE(?st_trip_id, "urn:x-kgc-bench:null") AS ?st_trip_id_k)
    OPTIONAL {
      SERVICE <x-sparql-anything:location=%DATA%/TRIPS.csv,csv.headers=true> { ?t xyz:trip_id ?st_trip_id_k }
      BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/trips/", ENCODE_FOR_URI(?st_trip_id_k))) AS ?st_trip)
    }
    BIND(COALESCE(?st_stop_id, "urn:x-kgc-bench:null") AS ?st_stop_id_k)
    OPTIONAL {
      SERVICE <x-sparql-anything:location=%DATA%/STOPS.csv,csv.headers=true> { ?s xyz:stop_id ?st_stop_id_k }
      BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/stops/", ENCODE_FOR_URI(?st_stop_id_k))) AS ?st_stop)
    }
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/stoptimes/", ENCODE_FOR_URI(?st_trip_id), "-", ENCODE_FOR_URI(?st_stop_id), "-", ENCODE_FOR_URI(?arrival_time))) AS ?stoptime)
    BIND(STRDT(?stop_sequence, xsd:integer) AS ?st_seq) BIND(STRDT(?st_shape_dist, xsd:double) AS ?st_dist)
    BIND(IRI(CONCAT("http://transport.linkeddata.es/resource/PickupType/", ENCODE_FOR_URI(?pickup_type))) AS ?pickup_iri)
    BIND(IRI(CONCAT("http://transport.linkeddata.es/resource/DropOffType/", ENCODE_FOR_URI(?drop_off_type))) AS ?dropoff_iri)
  } UNION {
    SERVICE <x-sparql-anything:location=%DATA%/FREQUENCIES.csv,csv.headers=true> {
      ?r xyz:trip_id ?fq_trip_id .
      OPTIONAL { ?r xyz:start_time ?start_time FILTER(?start_time != "") } OPTIONAL { ?r xyz:end_time ?end_time FILTER(?end_time != "") }
      OPTIONAL { ?r xyz:headway_secs ?headway_secs FILTER(?headway_secs != "") } OPTIONAL { ?r xyz:exact_times ?exact_times FILTER(?exact_times != "") }
    }
    BIND(COALESCE(?fq_trip_id, "urn:x-kgc-bench:null") AS ?fq_trip_id_k)
    OPTIONAL {
      SERVICE <x-sparql-anything:location=%DATA%/TRIPS.csv,csv.headers=true> { ?t xyz:trip_id ?fq_trip_id_k }
      BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/trips/", ENCODE_FOR_URI(?fq_trip_id_k))) AS ?fq_trip)
    }
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/frequency/", ENCODE_FOR_URI(?fq_trip_id), "-", ENCODE_FOR_URI(?start_time))) AS ?frequency)
    BIND(STRDT(?headway_secs, xsd:integer) AS ?headway) BIND(STRDT(?exact_times, xsd:boolean) AS ?exact)
  } UNION {
    SERVICE <x-sparql-anything:location=%DATA%/FEED_INFO.csv,csv.headers=true> {
      ?r xyz:feed_publisher_name ?feed_publisher_name .
      OPTIONAL { ?r xyz:feed_publisher_url ?feed_publisher_url FILTER(?feed_publisher_url != "") } OPTIONAL { ?r xyz:feed_lang ?feed_lang FILTER(?feed_lang != "") }
      OPTIONAL { ?r xyz:feed_start_date ?feed_start_date FILTER(?feed_start_date != "") } OPTIONAL { ?r xyz:feed_end_date ?feed_end_date FILTER(?feed_end_date != "") }
      OPTIONAL { ?r xyz:feed_version ?feed_version FILTER(?feed_version != "") }
    }
    BIND(IRI(CONCAT("http://transport.linkeddata.es/madrid/metro/feed/", ENCODE_FOR_URI(?feed_publisher_name))) AS ?feed)
    BIND(IRI(?feed_publisher_url) AS ?feed_page)
    BIND(STRDT(?feed_start_date, xsd:date) AS ?feed_start) BIND(STRDT(?feed_end_date, xsd:date) AS ?feed_end)
  }
}
