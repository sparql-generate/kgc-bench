    rr:subjectMap [ a rr:SubjectMap; rr:template "http://transport.linkeddata.es/resource/LocationType/{location_type}" ];
    rr:predicateObjectMap [ rr:predicateMap [ a rr:PredicateMap; rr:constant inv:locationType ];
        rr:objectMap [ a rr:ObjectMap; rr:template "http://transport.linkeddata.es/madrid/metro/stops/{stop_id}"; rr:termType rr:IRI ] ] .

