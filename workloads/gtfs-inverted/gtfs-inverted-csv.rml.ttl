    rml:logicalSource [ rml:source "/data/SHAPES.csv"; rml:referenceFormulation ql:CSV ];
    rr:subjectMap [ rr:template "http://transport.linkeddata.es/madrid/metro/shape/{shape_id}" ];
    rr:predicateObjectMap [ rr:predicate inv:shape;
        rr:objectMap [ rr:parentTriplesMap <http://example.com/trips_0>;
            rr:joinCondition [ rr:child "shape_id"; rr:parent "shape_id" ] ] ] .
