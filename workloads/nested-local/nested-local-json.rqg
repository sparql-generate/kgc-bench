# nested-local: the hand-written SPARQL-Generate counterpart of
# nested-local-json.rml.ttl. The items are iterated inside each person: the
# identifier of the person is in scope, and the IRI of an item is built from it.
BASE <http://example.org/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX ex:   <http://example.org/ns#>

GENERATE {
  <person/{STR(?id)}> a ex:Person ; ex:name ?name ; ex:city ?city ; ex:zip ?zip .
  GENERATE {
    <person/{STR(?id)}/item/{STR(?n)}> a ex:Item ; ex:owner <person/{STR(?id)}> ; ex:type ?type ; ex:weight ?w .
  }
  ITERATOR iter:JSONPath(?person, "$.items[*]", "$.n", "$.type", "$.weight") AS ?item ?n ?type ?weight
  WHERE { BIND(STRDT(STR(?weight), xsd:integer) AS ?w) } .
}
ITERATOR iter:JSONPath(<people.json>, "$.people[*]", "$.id", "$.name", "$.address.city", "$.address.zip")
      AS ?person ?id ?name ?city ?zip
