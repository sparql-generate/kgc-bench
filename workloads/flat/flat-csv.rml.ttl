# Synthetic flat CSV (harness/workloads.py): one triples map, eight columns,
# no join. The workload of the memory-bounded runs.
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <http://example.org/ns#> .
@base <http://example.org/mapping/> .

<Rows> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "rows.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rr:template "http://example.org/row/{id}" ; rr:class ex:Row ] ;
  rr:predicateObjectMap [ rr:predicate ex:name ; rr:objectMap [ rml:reference "name" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:city ; rr:objectMap [ rr:template "http://example.org/city/{city}" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:age ; rr:objectMap [ rml:reference "age" ; rr:datatype xsd:integer ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:score ; rr:objectMap [ rml:reference "score" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:email ; rr:objectMap [ rml:reference "email" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:joined ; rr:objectMap [ rml:reference "joined" ; rr:datatype xsd:date ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:tag ; rr:objectMap [ rml:reference "tag" ] ] .
