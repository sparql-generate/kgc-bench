# Synthetic flat CSV: the hand-written SPARQL-Generate counterpart of
# flat-csv.rml.ttl. The rows are read in batches of 10 000 (second argument
# of iter:CSV), and with the command-line option --stream each batch is
# written out before the next is read: memory does not grow with the file.
BASE <http://example.org/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX ex:   <http://example.org/ns#>

GENERATE {
  <row/{?id}> a ex:Row ; ex:name ?name ; ex:city <city/{?city}> ;
      ex:age ?a ; ex:score ?s ; ex:email ?email ; ex:joined ?j ; ex:tag ?tag .
}
ITERATOR iter:CSV(<rows.csv>, 10000, "id", "name", "city", "age", "score", "email", "joined", "tag")
      AS ?id ?name ?city ?age ?score ?email ?joined ?tag
WHERE {
  BIND(STRDT(?age, xsd:integer) AS ?a) BIND(STRDT(?score, xsd:decimal) AS ?s)
  BIND(STRDT(?joined, xsd:date) AS ?j)
}
