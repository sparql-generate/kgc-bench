# generated by scripts/gtfs_mappings.py from gtfs-csv.rml.ttl (GTFS-Madrid-Bench): do not edit
PREFIX : <http://example.com/ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX DropOffType: <http://transport.linkeddata.es/resource/DropOffType/>
PREFIX LocationType: <http://transport.linkeddata.es/resource/LocationType/>
PREFIX PickupType: <http://transport.linkeddata.es/resource/PickupType/>
PREFIX RouteType: <http://transport.linkeddata.es/resource/RouteType/>
PREFIX WheelchairBoardingStatus: <http://transport.linkeddata.es/resource/WheelchairBoardingStatus/>
PREFIX agency: <http://transport.linkeddata.es/madrid/agency/>
PREFIX calendardaterule: <http://transport.linkeddata.es/madrid/metro/calendar_date_rule/>
PREFIX calendarrules: <http://transport.linkeddata.es/madrid/metro/calendar_rules/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX feed: <http://transport.linkeddata.es/madrid/metro/feed/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX frequency: <http://transport.linkeddata.es/madrid/metro/frequency/>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX gtfs: <http://vocab.gtfs.org/terms#>
PREFIX routes: <http://transport.linkeddata.es/madrid/metro/routes/>
PREFIX schema: <http://schema.org/>
PREFIX schemehttp: <http://>
PREFIX schemehttps: <https://>
PREFIX services: <http://transport.linkeddata.es/madrid/metro/services/>
PREFIX shape: <http://transport.linkeddata.es/madrid/metro/shape/>
PREFIX shapepoint: <http://transport.linkeddata.es/madrid/metro/shape_point/>
PREFIX stops: <http://transport.linkeddata.es/madrid/metro/stops/>
PREFIX stoptimes: <http://transport.linkeddata.es/madrid/metro/stoptimes/>
PREFIX trips: <http://transport.linkeddata.es/madrid/metro/trips/>
SOURCE agency_csv <file://%DATA%/AGENCY.csv>
SOURCE calendar_csv <file://%DATA%/CALENDAR.csv>
SOURCE calendar_dates_csv <file://%DATA%/CALENDAR_DATES.csv>
SOURCE feed_info_csv <file://%DATA%/FEED_INFO.csv>
SOURCE frequencies_csv <file://%DATA%/FREQUENCIES.csv>
SOURCE routes_csv <file://%DATA%/ROUTES.csv>
SOURCE shapes_csv <file://%DATA%/SHAPES.csv>
SOURCE stops_csv <file://%DATA%/STOPS.csv>
SOURCE stop_times_csv <file://%DATA%/STOP_TIMES.csv>
SOURCE trips_csv <file://%DATA%/TRIPS.csv>
FUNCTIONS helper <java: file://%MAPPINGS%/shexml-functions.java>
ITERATOR agency_it <csvperrow> {
    FIELD agency_fare_url <agency_fare_url>
    FIELD agency_id <agency_id>
    FIELD agency_lang <agency_lang>
    FIELD agency_name <agency_name>
    FIELD agency_phone <agency_phone>
    FIELD agency_timezone <agency_timezone>
    FIELD agency_url <agency_url>
}
ITERATOR calendar_it <csvperrow> {
    FIELD end_date <end_date>
    FIELD friday <friday>
    FIELD monday <monday>
    FIELD saturday <saturday>
    FIELD service_id <service_id>
    FIELD start_date <start_date>
    FIELD sunday <sunday>
    FIELD thursday <thursday>
    FIELD tuesday <tuesday>
    FIELD wednesday <wednesday>
}
ITERATOR calendar_dates_it <csvperrow> {
    FIELD date <date>
    FIELD exception_type <exception_type>
    FIELD service_id <service_id>
}
ITERATOR feed_info_it <csvperrow> {
    FIELD feed_end_date <feed_end_date>
    FIELD feed_lang <feed_lang>
    FIELD feed_publisher_name <feed_publisher_name>
    FIELD feed_publisher_url <feed_publisher_url>
    FIELD feed_start_date <feed_start_date>
    FIELD feed_version <feed_version>
}
ITERATOR frequencies_it <csvperrow> {
    FIELD end_time <end_time>
    FIELD exact_times <exact_times>
    FIELD headway_secs <headway_secs>
    FIELD start_time <start_time>
    FIELD trip_id <trip_id>
}
ITERATOR routes_it <csvperrow> {
    FIELD agency_id <agency_id>
    FIELD route_color <route_color>
    FIELD route_desc <route_desc>
    FIELD route_id <route_id>
    FIELD route_long_name <route_long_name>
    FIELD route_short_name <route_short_name>
    FIELD route_text_color <route_text_color>
    FIELD route_type <route_type>
    FIELD route_url <route_url>
}
ITERATOR shapes_it <csvperrow> {
    FIELD shape_dist_traveled <shape_dist_traveled>
    FIELD shape_id <shape_id>
    FIELD shape_pt_lat <shape_pt_lat>
    FIELD shape_pt_lon <shape_pt_lon>
    FIELD shape_pt_sequence <shape_pt_sequence>
}
ITERATOR stops_it <csvperrow> {
    FIELD location_type <location_type>
    FIELD parent_station <parent_station>
    FIELD stop_code <stop_code>
    FIELD stop_desc <stop_desc>
    FIELD stop_id <stop_id>
    FIELD stop_lat <stop_lat>
    FIELD stop_lon <stop_lon>
    FIELD stop_name <stop_name>
    FIELD stop_timezone <stop_timezone>
    FIELD stop_url <stop_url>
    FIELD wheelchair_boarding <wheelchair_boarding>
    FIELD zone_id <zone_id>
}
ITERATOR stop_times_it <csvperrow> {
    FIELD arrival_time <arrival_time>
    FIELD departure_time <departure_time>
    FIELD drop_off_type <drop_off_type>
    FIELD pickup_type <pickup_type>
    FIELD shape_dist_traveled <shape_dist_traveled>
    FIELD stop_headsign <stop_headsign>
    FIELD stop_id <stop_id>
    FIELD stop_sequence <stop_sequence>
    FIELD trip_id <trip_id>
}
ITERATOR trips_it <csvperrow> {
    FIELD block_id <block_id>
    FIELD direction_id <direction_id>
    FIELD route_id <route_id>
    FIELD service_id <service_id>
    FIELD shape_id <shape_id>
    FIELD trip_headsign <trip_headsign>
    FIELD trip_id <trip_id>
    FIELD trip_short_name <trip_short_name>
    FIELD wheelchair_accessible <wheelchair_accessible>
}
EXPRESSION agency <agency_csv.agency_it>
EXPRESSION calendar <calendar_csv.calendar_it>
EXPRESSION calendar_dates <calendar_dates_csv.calendar_dates_it>
EXPRESSION feed_info <feed_info_csv.feed_info_it>
EXPRESSION frequencies <frequencies_csv.frequencies_it>
EXPRESSION routes <routes_csv.routes_it>
EXPRESSION shapes <shapes_csv.shapes_it>
EXPRESSION stops <stops_csv.stops_it>
EXPRESSION stop_times <stop_times_csv.stop_times_it>
EXPRESSION trips <trips_csv.trips_it>
EXPRESSION key1 <calendar_dates_csv.calendar_dates_it.service_id + "-" + calendar_dates_csv.calendar_dates_it.date>
EXPRESSION key2 <frequencies_csv.frequencies_it.trip_id + "-" + frequencies_csv.frequencies_it.start_time>
EXPRESSION key3 <calendar_dates_csv.calendar_dates_it.service_id + "-" + calendar_dates_csv.calendar_dates_it.date>
EXPRESSION key4 <shapes_csv.shapes_it.shape_id + "-" + shapes_csv.shapes_it.shape_pt_sequence>
EXPRESSION key5 <shapes_csv.shapes_it.shape_id + "-" + shapes_csv.shapes_it.shape_pt_sequence>
EXPRESSION key6 <stop_times_csv.stop_times_it.trip_id + "-" + stop_times_csv.stop_times_it.stop_id + "-" + stop_times_csv.stop_times_it.arrival_time>

:agency_0 agency:[agency.agency_id] {
    a gtfs:Agency ;
    foaf:page schemehttp:[helper.httpRest(agency.agency_url)] ;
    foaf:name [agency.agency_name] ;
    gtfs:timeZone [agency.agency_timezone] ;
    dct:language [agency.agency_lang] ;
    foaf:phone [agency.agency_phone] ;
    gtfs:fareUrl schemehttps:[helper.httpsRest(agency.agency_fare_url)] ;
}
:calendar_date_rules_0 calendardaterule:[key1] {
    a gtfs:CalendarDateRule ;
    dct:date [calendar_dates.date] xsd:date ;
    gtfs:dateAddition [calendar_dates.exception_type] xsd:boolean ;
}
:calendar_rules_0 calendarrules:[calendar.service_id] {
    a gtfs:CalendarRule ;
    gtfs:monday [calendar.monday] xsd:boolean ;
    gtfs:tuesday [calendar.tuesday] xsd:boolean ;
    gtfs:wednesday [calendar.wednesday] xsd:boolean ;
    gtfs:thursday [calendar.thursday] xsd:boolean ;
    gtfs:friday [calendar.friday] xsd:boolean ;
    gtfs:saturday [calendar.saturday] xsd:boolean ;
    gtfs:sunday [calendar.sunday] xsd:boolean ;
    schema:startDate [calendar.start_date] xsd:date ;
    schema:endDate [calendar.end_date] xsd:date ;
}
:feed_0 feed:[feed_info.feed_publisher_name] {
    a gtfs:Feed ;
    dct:publisher [feed_info.feed_publisher_name] ;
    foaf:page schemehttp:[helper.httpRest(feed_info.feed_publisher_url)] ;
    dct:language [feed_info.feed_lang] ;
    schema:startDate [feed_info.feed_start_date] xsd:date ;
    schema:endDate [feed_info.feed_end_date] xsd:date ;
    schema:version [feed_info.feed_version] ;
}
:frequencies_0 frequency:[key2] {
    a gtfs:Frequency ;
    gtfs:startTime [frequencies.start_time] ;
    gtfs:endTime [frequencies.end_time] ;
    gtfs:headwaySeconds [frequencies.headway_secs] xsd:integer ;
    gtfs:exactTimes [frequencies.exact_times] xsd:boolean ;
    gtfs:trip trips:[frequencies.trip_id] ;
}
:routes_0 routes:[routes.route_id] {
    a gtfs:Route ;
    gtfs:shortName [routes.route_short_name] ;
    gtfs:longName [routes.route_long_name] ;
    dct:description [routes.route_desc] ;
    gtfs:routeType RouteType:[routes.route_type] ;
    gtfs:routeUrl schemehttp:[helper.httpRest(routes.route_url)] ;
    gtfs:color [routes.route_color] ;
    gtfs:textColor [routes.route_text_color] ;
    gtfs:agency agency:[routes.agency_id] ;
}
:services1_0 services:[calendar.service_id] {
    a gtfs:Service ;
    gtfs:serviceRule calendarrules:[calendar.service_id] ;
}
:services2_0 services:[calendar_dates.service_id] {
    a gtfs:Service ;
    gtfs:serviceRule calendardaterule:[key3] ;
}
:shapePoints_0 shapepoint:[key4] {
    a gtfs:ShapePoint ;
    geo:lat [shapes.shape_pt_lat] xsd:double ;
    geo:long [shapes.shape_pt_lon] xsd:double ;
    gtfs:pointSequence [shapes.shape_pt_sequence] ;
    gtfs:distanceTraveled [shapes.shape_dist_traveled] xsd:double ;
}
:shapes_0 shape:[shapes.shape_id] {
    a gtfs:Shape ;
    gtfs:shapePoint shapepoint:[key5] ;
}
:stops_0 stops:[stops.stop_id] {
    a gtfs:Stop ;
    gtfs:code [stops.stop_code] ;
    dct:identifier [stops.stop_id] ;
    foaf:name [stops.stop_name] ;
    dct:description [stops.stop_desc] ;
    geo:lat [stops.stop_lat] xsd:double ;
    geo:long [stops.stop_lon] xsd:double ;
    gtfs:zone [stops.zone_id IF helper.notEmpty(stops.zone_id)] ;
    foaf:page schemehttp:[helper.httpRest(stops.stop_url)] ;
    gtfs:locationType LocationType:[stops.location_type] ;
    gtfs:timeZone [stops.stop_timezone IF helper.notEmpty(stops.stop_timezone)] ;
    gtfs:wheelchairAccessible WheelchairBoardingStatus:[stops.wheelchair_boarding] ;
    gtfs:parentStation stops:[stops.parent_station IF helper.notEmpty(stops.parent_station)] ;
}
:stoptimes_0 stoptimes:[key6] {
    a gtfs:StopTime ;
    gtfs:arrivalTime [stop_times.arrival_time] ;
    gtfs:departureTime [stop_times.departure_time] ;
    gtfs:stopSequence [stop_times.stop_sequence IF helper.notEmpty(stop_times.stop_sequence)] xsd:integer ;
    gtfs:headsign [stop_times.stop_headsign] ;
    gtfs:pickupType PickupType:[stop_times.pickup_type] ;
    gtfs:dropOffType DropOffType:[stop_times.drop_off_type] ;
    gtfs:distanceTraveled [stop_times.shape_dist_traveled] xsd:double ;
    gtfs:trip trips:[stop_times.trip_id] ;
    gtfs:stop stops:[stop_times.stop_id] ;
}
:trips_0 trips:[trips.trip_id] {
    a gtfs:Trip ;
    gtfs:headsign [trips.trip_headsign] ;
    gtfs:shortName [trips.trip_short_name] ;
    gtfs:direction [trips.direction_id] ;
    gtfs:block [trips.block_id] ;
    gtfs:wheelchairAccessible WheelchairBoardingStatus:[trips.wheelchair_accessible] ;
    gtfs:service services:[trips.service_id] ;
    gtfs:route routes:[trips.route_id] ;
    gtfs:shape shape:[trips.shape_id] ;
}
