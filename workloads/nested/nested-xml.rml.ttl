# Synthetic nested XML (harness/workloads.py): people, each with an address
# object and three items. Two iterations: people, and the items nested in
# them; references into a nested object (address/city), attributes (@id).
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <http://example.org/ns#> .
@base <http://example.org/mapping/> .

<People> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "people.xml" ; rml:referenceFormulation ql:XPath ; rml:iterator "/people/person" ] ;
  rr:subjectMap [ rr:template "http://example.org/person/{@id}" ; rr:class ex:Person ] ;
  rr:predicateObjectMap [ rr:predicate ex:name ; rr:objectMap [ rml:reference "name" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:city ; rr:objectMap [ rml:reference "address/city" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:zip ; rr:objectMap [ rml:reference "address/zip" ] ] .

<Items> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "people.xml" ; rml:referenceFormulation ql:XPath ; rml:iterator "/people/person/items/item" ] ;
  rr:subjectMap [ rr:template "http://example.org/item/{@id}" ; rr:class ex:Item ] ;
  rr:predicateObjectMap [ rr:predicate ex:type ; rr:objectMap [ rml:reference "type" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:weight ; rr:objectMap [ rml:reference "weight" ; rr:datatype xsd:integer ] ] .
