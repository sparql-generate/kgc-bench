# gtfs-fn, nested form (not a workload: on 2026-11-27 FlexRML 3.1.0, Morph-KGC 2.10.0,
# BURP 0.1.3 and SDM-RDFizer 4.7.5.15.4.1 all stop on it, each with another error):
# the shapes and the shape points of GTFS-Madrid-Bench with a code computed
# from shape_id by two functions, one applied to the result of the other
# (grel:string_replace of grel:toUpperCase): an RML-FNML function execution whose input
# is another function execution. The same execution is the object of a triple of every
# row in two triples maps.
@prefix rml:  <http://w3id.org/rml/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix gtfs: <http://vocab.gtfs.org/terms#> .
@prefix geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix ex:   <http://example.org/ns#> .
@base <http://example.com/ns#> .

<ShapesSource> a rml:LogicalSource ;
  rml:source [ a rml:FilePath ; rml:path "/data/SHAPES.csv" ; rml:null "" ] ; rml:referenceFormulation rml:CSV .

<Upper> rml:function grel:toUpperCase ;
  rml:input [ rml:parameter grel:valueParam ; rml:inputValueMap [ rml:reference "shape_id" ] ] .
<Code> rml:function grel:string_replace ;
  rml:input [ rml:parameter grel:valueParam ;
              rml:inputValueMap [ rml:functionExecution <Upper> ; rml:return grel:stringOut ] ] ,
            [ rml:parameter grel:p_string_find ; rml:inputValue "0" ] ,
            [ rml:parameter grel:p_string_replace ; rml:inputValue "O" ] .

<Shapes> a rml:TriplesMap ;
  rml:logicalSource <ShapesSource> ;
  rml:subjectMap [ rml:template "http://transport.linkeddata.es/madrid/metro/shape/{shape_id}" ; rml:class gtfs:Shape ] ;
  rml:predicateObjectMap [ rml:predicate ex:code ;
    rml:objectMap [ rml:functionExecution <Code> ; rml:return grel:stringOut ] ] .

<ShapePoints> a rml:TriplesMap ;
  rml:logicalSource <ShapesSource> ;
  rml:subjectMap [ rml:template "http://transport.linkeddata.es/madrid/metro/shape_point/{shape_id}-{shape_pt_sequence}" ;
                   rml:class gtfs:ShapePoint ] ;
  rml:predicateObjectMap [ rml:predicate geo:lat ; rml:objectMap [ rml:reference "shape_pt_lat" ] ] ;
  rml:predicateObjectMap [ rml:predicate geo:long ; rml:objectMap [ rml:reference "shape_pt_lon" ] ] ;
  rml:predicateObjectMap [ rml:predicate gtfs:pointSequence ; rml:objectMap [ rml:reference "shape_pt_sequence" ] ] ;
  rml:predicateObjectMap [ rml:predicate ex:shapeCode ;
    rml:objectMap [ rml:functionExecution <Code> ; rml:return grel:stringOut ] ] .
