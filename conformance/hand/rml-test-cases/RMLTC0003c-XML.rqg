# Literal built from a template: first name and last name.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

GENERATE {
  <http://example.com/Student{?ID}> foaf:name "{?FirstName} {?LastName}" .
}
ITERATOR iter:XPath(<student.xml>, "/students/student",
    "/student/ID/text()", "/student/FirstName/text()", "/student/LastName/text()")
  AS ?student ?ID ?FirstName ?LastName
