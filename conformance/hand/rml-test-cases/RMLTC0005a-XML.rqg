# Typing of resources; a template with a constant ";", values kept verbatim.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX ex: <http://example.com/>

GENERATE {
  <http://example.com/{?fname};{?lname}> a foaf:Person ;
      ex:owes ?amount .
}
ITERATOR iter:XPath(<ious.xml>, "/persons/person",
    "/person/fname/text()", "/person/lname/text()", "/person/amount/text()")
  AS ?person ?fname ?lname ?amount
