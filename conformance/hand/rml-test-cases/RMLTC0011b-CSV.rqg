# M-N relation through a link table: three sources, three families of
# triples, no join needed (the link table holds both keys).
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX ex: <http://example.com/>

GENERATE {
  GENERATE {
    <http://example.com/student/{?ID}> ex:firstName ?FirstName ; ex:lastName ?LastName .
  }
  ITERATOR iter:CSV(<student.csv>, "ID", "FirstName", "LastName") AS ?ID ?FirstName ?LastName .

  GENERATE {
    <http://example.com/sport/{?ID}> ex:id ?ID ; ex:description ?Description .
  }
  ITERATOR iter:CSV(<sport.csv>, "ID", "Description") AS ?ID ?Description .

  GENERATE {
    <http://example.com/student/{?student}> ex:plays <http://example.com/sport/{?sport}> .
  }
  ITERATOR iter:CSV(<student_sport.csv>, "ID_Student", "ID_Sport") AS ?student ?sport .
}
WHERE {}
