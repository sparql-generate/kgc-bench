# IRIs read from a column: an absolute IRI is kept, a relative one is
# concatenated to the base IRI without dot-segment removal; the invalid value
# ("Emily Smith") makes IRI() fail, and its row yields no triple.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

GENERATE {
  ?s a foaf:Person .
}
ITERATOR iter:CSV(<student.csv>, "Name") AS ?Name
WHERE {
  BIND(IRI(IF(REGEX(?Name, "^[A-Za-z][A-Za-z0-9+.-]*:"), ?Name,
              CONCAT("http://example.com/base/", ?Name))) AS ?s)
}
