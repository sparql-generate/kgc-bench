# Subject IRIs read from a column, one of which is invalid ("Juan Daniel"):
# IRI() fails on it, ?person stays unbound, and the row yields no triple.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

GENERATE {
  ?person foaf:name ?FirstName .
}
ITERATOR iter:CSV(<persons.csv>, "FirstName") AS ?FirstName
WHERE {
  BIND(IRI(IF(REGEX(?FirstName, "^[A-Za-z][A-Za-z0-9+.-]*:"), ?FirstName,
              CONCAT("http://example.com/base/", ?FirstName))) AS ?person)
}
