# A literal template with escaped braces, "{{{ BO }}}": in a SPARQL-Generate
# literal, a brace that opens no expression is escaped as \{.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX ex: <http://example.com/>

GENERATE {
  <http://example.com/{?code}/{?Name}> ex:code "\{\{\{ {?iso} \}\}\}" .
}
ITERATOR iter:CSV(<country_info.csv>, "Country Code", "Name", "ISO 3166") AS ?code ?Name ?iso
