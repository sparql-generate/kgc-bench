# Foreign-key join student/Sport = sport/ID. The sports' keys are first
# generated into the default graph (FROM GENERATE), so that the join is a
# plain SPARQL graph pattern. A missing Sport element is unbound, and an
# unbound variable would match any key: it is replaced by an IRI, which no
# key equals.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

GENERATE {
  GENERATE {
    <http://example.com/resource/sport_{?ID}> rdfs:label ?Name .
  }
  ITERATOR iter:XPath(<sport.xml>, "/sports/sport",
      "/sport/ID/text()", "/sport/Name/text()") AS ?sport ?ID ?Name .

  GENERATE {
    <http://example.com/resource/student_{?ID}> foaf:name ?Name .
  }
  ITERATOR iter:XPath(<student.xml>, "/students/student",
      "/student/ID/text()", "/student/Name/text()") AS ?student ?ID ?Name .

  GENERATE {
    <http://example.com/resource/student_{?ID}>
        <http://example.com/ontology/practises> ?sport .
  }
  FROM GENERATE {
    ?sport <urn:x-kgc-bench:key> ?key .
  }
  ITERATOR iter:XPath(<sport.xml>, "/sports/sport", "/sport/ID/text()") AS ?s ?key
  WHERE { BIND(<http://example.com/resource/sport_{?key}> AS ?sport) } .
  ITERATOR iter:XPath(<student.xml>, "/students/student",
      "/student/ID/text()", "/student/Sport/text()") AS ?student ?ID ?Sport
  WHERE {
    BIND(COALESCE(?Sport, <urn:x-kgc-bench:null>) AS ?key)
    ?sport <urn:x-kgc-bench:key> ?key
  } .
}
WHERE {}
