# M-N relation through a link document: three sources, three independent
# iterations, no join needed.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX ex: <http://example.com/>

GENERATE {
  GENERATE {
    <http://example.com/student/{?ID}> ex:firstName ?FirstName ; ex:lastName ?LastName .
  }
  ITERATOR iter:XPath(<student.xml>, "/Students/Student", "/Student/ID/text()",
      "/Student/FirstName/text()", "/Student/LastName/text()") AS ?s ?ID ?FirstName ?LastName .

  GENERATE {
    <http://example.com/sport/{?ID}> ex:id ?ID ; ex:description ?Description .
  }
  ITERATOR iter:XPath(<sport.xml>, "/Sports/Sport",
      "/Sport/ID/text()", "/Sport/Description/text()") AS ?s ?ID ?Description .

  GENERATE {
    <http://example.com/student/{?ID_Student}> ex:plays <http://example.com/sport/{?ID_Sport}> .
  }
  ITERATOR iter:XPath(<student_sport.xml>, "/links/link",
      "/link/ID_Student/text()", "/link/ID_Sport/text()") AS ?l ?ID_Student ?ID_Sport .
}
WHERE {}
