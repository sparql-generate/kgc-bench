# Typing resources with rdf:type.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

GENERATE {
  <http://example.com/Student/{?ID}/{?FirstName}> a foaf:Person .
}
ITERATOR iter:CSV(<student.csv>, "ID", "FirstName") AS ?ID ?FirstName
