# Blank-node subject from a template ("students{ID}"): one solution per key.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

GENERATE {
  _:student foaf:name ?Name .
}
ITERATOR iter:JSONPath(<student.json>, "$.students[*]", "$.ID", "$.Name") AS ?rec ?ID ?Name
WHERE {}
GROUP BY ?ID ?Name
