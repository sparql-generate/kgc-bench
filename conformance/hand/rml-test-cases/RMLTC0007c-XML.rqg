# Two classes (rr:class) and two properties.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX ex: <http://example.com/>

GENERATE {
  <http://example.com/Student/{?ID}/{?FirstName}>
      a foaf:Person, ex:Student ;
      ex:id ?ID ;
      foaf:name ?FirstName .
}
ITERATOR iter:XPath(<student.xml>, "/students/student",
    "/student/ID/text()", "/student/FirstName/text()") AS ?student ?ID ?FirstName
