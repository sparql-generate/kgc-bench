# Foreign-key join student.Sport = sport.ID. The sports' keys are first
# generated into the default graph (FROM GENERATE), so that the join is a
# plain SPARQL graph pattern: a student without a matching sport yields no
# ex:practises triple. A missing value (empty cell) is unbound, and an unbound
# variable would match any key: it is replaced by an IRI, which no key equals.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

GENERATE {
  GENERATE {
    <http://example.com/resource/sport_{?ID}> rdfs:label ?Name .
  }
  ITERATOR iter:CSV(<sport.csv>, "ID", "Name") AS ?ID ?Name .

  GENERATE {
    <http://example.com/resource/student_{?ID}> foaf:name ?Name .
  }
  ITERATOR iter:CSV(<student.csv>, "ID", "Name") AS ?ID ?Name .

  GENERATE {
    <http://example.com/resource/student_{?ID}>
        <http://example.com/ontology/practises> ?sport .
  }
  FROM GENERATE {
    ?sport <urn:x-kgc-bench:key> ?key .
  }
  ITERATOR iter:CSV(<sport.csv>, "ID") AS ?key
  WHERE { BIND(IRI(CONCAT("http://example.com/resource/sport_", ENCODE_FOR_URI(?key))) AS ?sport) } .
  ITERATOR iter:CSV(<student.csv>, "ID", "Sport") AS ?ID ?Sport
  WHERE {
    BIND(COALESCE(?Sport, <urn:x-kgc-bench:null>) AS ?key)
    ?sport <urn:x-kgc-bench:key> ?key
  } .
}
WHERE {}
