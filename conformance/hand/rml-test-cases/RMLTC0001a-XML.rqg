# One column; IRI subject built from a template.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

GENERATE {
  <http://example.com/{?Name}> foaf:name ?Name .
}
ITERATOR iter:XPath(<student.xml>, "/students/student", "/student/Name/text()") AS ?student ?Name
