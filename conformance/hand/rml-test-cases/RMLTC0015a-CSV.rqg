# Language tags on literals, from two sources (English and Spanish names).
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

GENERATE {
  GENERATE {
    <http://example.com/{?Code}> rdfs:label "{?Name}"@en .
  }
  ITERATOR iter:CSV(<country_en.csv>, "Code", "Name") AS ?Code ?Name .
  GENERATE {
    <http://example.com/{?Code}> rdfs:label "{?Name}"@es .
  }
  ITERATOR iter:CSV(<country_es.csv>, "Code", "Name") AS ?Code ?Name .
}
WHERE {}
