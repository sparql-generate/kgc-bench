# Typing of resources; a constant ";" in the template; values kept verbatim.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX ex: <http://example.com/>

GENERATE {
  <http://example.com/{?fname};{?lname}> a foaf:Person ;
      ex:owes ?amount .
}
ITERATOR iter:CSV(<ious.csv>, "fname", "lname", "amount") AS ?fname ?lname ?amount
