# Typing only, through an rdf:type predicate-object map.
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

GENERATE {
  <http://example.com/Student/{?ID}/{?FirstName}> a foaf:Person .
}
ITERATOR iter:XPath(<student.xml>, "/students/student",
    "/student/ID/text()", "/student/FirstName/text()") AS ?student ?ID ?FirstName
