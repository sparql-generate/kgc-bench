# Values with special characters in an IRI template: the expressions embedded
# in an IRI of a GENERATE template are percent-encoded (IRI-safe).
BASE <http://example.com/base/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX ex: <http://example.com/>

GENERATE {
  <http://example.com/{?code}/{?Name}> ex:name ?Name .
}
ITERATOR iter:CSV(<country_info.csv>, "Country Code", "Name") AS ?code ?Name
