# Blank-node subject whose identity is the value of a column. A blank node
# of a GENERATE template is fresh for each solution: one solution per key.
BASE <http://example.com/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

GENERATE {
  _:student foaf:name ?Name .
}
ITERATOR iter:JSONPath(<student.json>, "$.students[*]", "$.Name") AS ?rec ?Name
WHERE {}
GROUP BY ?Name
