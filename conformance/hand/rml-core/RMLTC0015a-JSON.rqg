# Language tags on literals, from two sources (English and Spanish names).
BASE <http://example.com/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

GENERATE {
  GENERATE {
    <http://example.com/{?Code}> rdfs:label "{?Name}"@en .
  }
  ITERATOR iter:JSONPath(<country_en.json>, "$.countries[*]", "$.Code", "$.Name") AS ?rec ?Code ?Name .
  GENERATE {
    <http://example.com/{?Code}> rdfs:label "{?Name}"@es .
  }
  ITERATOR iter:JSONPath(<country_es.json>, "$.countries[*]", "$.Code", "$.Name") AS ?rec ?Code ?Name .
}
WHERE {}
