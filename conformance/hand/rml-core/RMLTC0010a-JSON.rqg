# A column whose name contains a space ("Country Code").
BASE <http://example.com/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX ex: <http://example.com/>

GENERATE {
  <http://example.com/{STR(?code)}> ex:name ?Name .
}
ITERATOR iter:JSONPath(<country_info.json>, "$.countries[*]", "$['Country Code']", "$.Name") AS ?rec ?code ?Name
