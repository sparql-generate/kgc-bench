# Term type rml:URI: the values are percent-encoded outside the unreserved
# set (non-ASCII characters included), which is what SPARQL-Generate does to
# an expression inside an IRI of a GENERATE template (ENCODE_FOR_URI).
BASE <http://example.com/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

GENERATE {
  <http://example.com/Person/{?Name}> a foaf:Person .
}
ITERATOR iter:JSONPath(<student.json>, "$.students[*]", "$.Name") AS ?rec ?Name
