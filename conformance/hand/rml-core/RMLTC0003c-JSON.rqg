# A literal built from a template of two columns.
BASE <http://example.com/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

GENERATE {
  <http://example.com/Student{STR(?ID)}> foaf:name "{?FirstName} {?LastName}" .
}
ITERATOR iter:JSONPath(<student.json>, "$.students[*]", "$.ID", "$.FirstName", "$.LastName") AS ?rec ?ID ?FirstName ?LastName
