@prefix rml: <http://w3id.org/rml/> .
@prefix ex:  <http://example.com/> .

<http://example.com/base/TM> a rml:TriplesMap ;
  rml:logicalSource [
    rml:source [ a rml:RelativePathSource ; rml:root rml:MappingDirectory ; rml:path "data.xml" ] ;
    rml:referenceFormulation rml:XPath ;
    rml:iterator "/people/person" ] ;
  rml:subjectMap [ rml:template "http://example.com/person/{@id}" ] ;
  rml:predicateObjectMap [ rml:predicate ex:name ; rml:objectMap [ rml:reference "name" ] ] ;
  rml:predicateObjectMap [ rml:predicate ex:kind ; rml:objectMap [ rml:reference "@kind" ] ] .
