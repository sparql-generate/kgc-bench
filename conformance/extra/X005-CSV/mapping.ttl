@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix ex:  <http://example.com/> .
@base <http://example.com/base/> .

# a join whose child has a graph map with an expression
<TriplesMap1> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "students.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rr:template "http://example.com/student/{ID}" ; rr:class ex:Student ;
                  rr:graphMap [ rr:template "http://example.com/g/{Name}" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:practises ;
    rr:objectMap [ rr:parentTriplesMap <TriplesMap2> ;
                   rr:joinCondition [ rr:child "Sport" ; rr:parent "ID" ] ] ;
    rr:graphMap [ rr:constant ex:practise ] ] .

<TriplesMap2> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "sports.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rr:template "http://example.com/sport/{ID}" ] ;
  rr:predicateObjectMap [ rr:predicate ex:label ; rr:objectMap [ rml:reference "Name" ] ] .

# a blank node subject without expression: the join is made in its iteration
<TriplesMap3> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "students.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rr:termType rr:BlankNode ;
                  rr:graphMap [ rr:template "http://example.com/g2/{Name}" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:name ; rr:objectMap [ rml:reference "Name" ] ] ;
  rr:predicateObjectMap [ rr:predicate ex:sport ;
    rr:objectMap [ rr:parentTriplesMap <TriplesMap2> ;
                   rr:joinCondition [ rr:child "Sport" ; rr:parent "ID" ] ] ;
    rr:graph ex:sports ] .
