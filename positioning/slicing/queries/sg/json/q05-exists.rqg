# people who share their city with someone else (FILTER EXISTS)
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?name
ITERATOR iter:JSONSurfer(<people.json>, "$[*]"%BATCH%, "$.id", "$.name", "$.city",
    "$.manager", "$.score") AS ?r ?id ?name ?city ?manager ?score
ITERATOR iter:JSONSurfer(<people.json>, "$[*]"%BATCH%, "$.id", "$.name", "$.city",
    "$.manager", "$.score") AS ?r2 ?id2 ?name2 ?city2 ?manager2 ?score2
WHERE { FILTER(STR(?city2) = STR(?city) && STR(?id2) != STR(?id)) }
