# the three best scores, ORDER BY and LIMIT inside SERVICE
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?name
ITERATOR iter:JSONSurfer(<people.json>, "$[*]"%BATCH%, "$.id", "$.name", "$.city",
    "$.manager", "$.score") AS ?r ?id ?name ?city ?manager ?score
WHERE { }
ORDER BY DESC(?score) ?name LIMIT 3
