# each person and the name of their manager (join on a key)
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?name ?name2
ITERATOR iter:CSV(<people.csv>%BATCH%, "id", "name", "city", "manager", "score")
    AS ?id ?name ?city ?manager ?score
ITERATOR iter:CSV(<people.csv>%BATCH%, "id", "name", "city", "manager", "score")
    AS ?id2 ?name2 ?city2 ?manager2 ?score2
WHERE { FILTER(BOUND(?manager) && STR(?manager) = STR(?id2)) }
