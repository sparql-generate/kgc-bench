# the three best scores, ORDER BY and LIMIT inside SERVICE
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?name
ITERATOR iter:CSV(<people.csv>%BATCH%, "id", "name", "city", "manager", "score")
    AS ?id ?name ?city ?manager ?score
WHERE { }
ORDER BY DESC(xsd:integer(?score)) ?name LIMIT 3
