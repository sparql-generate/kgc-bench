# people per city, GROUP BY outside SERVICE (outside)
PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx:  <http://sparql.xyz/facade-x/ns/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?city (COUNT(*) AS ?n) WHERE { SERVICE <x-sparql-anything:location=%DATA%/people.csv,csv.headers=true%OPTIONS%> {
  ?r xyz:id ?id ; xyz:name ?name ; xyz:city ?city ; xyz:score ?score .
} } GROUP BY ?city
