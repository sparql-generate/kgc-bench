# people per city, GROUP BY inside SERVICE (inside)
PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx:  <http://sparql.xyz/facade-x/ns/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?city ?n WHERE { SERVICE <x-sparql-anything:location=%DATA%/people.csv,csv.headers=true%OPTIONS%> {
  SELECT ?city (COUNT(*) AS ?n) WHERE {
    ?r xyz:id ?id ; xyz:name ?name ; xyz:city ?city ; xyz:score ?score .
  } GROUP BY ?city
} }
