# people with a score of 50 or more (plain)
PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx:  <http://sparql.xyz/facade-x/ns/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?name WHERE { SERVICE <x-sparql-anything:location=%DATA%/people.csv,csv.headers=true%OPTIONS%> {
  ?r xyz:id ?id ; xyz:name ?name ; xyz:city ?city ; xyz:score ?score .
  FILTER(xsd:integer(STR(?score)) >= 50)
} }
