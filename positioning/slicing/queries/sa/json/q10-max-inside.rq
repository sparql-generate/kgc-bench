# the best score, MAX inside SERVICE (inside)
PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx:  <http://sparql.xyz/facade-x/ns/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?m WHERE { SERVICE <x-sparql-anything:location=%DATA%/people.json%OPTIONS%> {
  SELECT (MAX(xsd:integer(STR(?score))) AS ?m) WHERE {
    ?r xyz:id ?id ; xyz:name ?name ; xyz:city ?city ; xyz:score ?score .
  }
} }
