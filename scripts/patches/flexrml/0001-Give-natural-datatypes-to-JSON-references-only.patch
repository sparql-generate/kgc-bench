From e677b16c3efe237fc3c85ec6b93a625446306d29 Mon Sep 17 00:00:00 2001
From: Maxime <maxime.lefrancois@emse.fr>
Date: Thu, 26 Nov 2026 21:35:38 +0100
Subject: [PATCH] Give natural datatypes to JSON references only

A literal reference without rml:datatype or rml:language was typed from its
lexical form, whatever its source: "33" became "33"^^xsd:integer from a CSV
cell or an XML text node too, and in mappings of the legacy vocabulary.
RML-Core gives a natural datatype only to values that have one (JSON numbers
and booleans); a CSV or XML value is a string. The RML-IO test cases expect
simple literals for CSV sources (RMLSTC0004a-c, RMLSTC0006b, RMLSTC0007b,
RMLSTC0009a, kg-construct/rml-io), and the RML test cases of the legacy
vocabulary (RMLio/rml-test-cases) for every source (issue #8).

The frontend now marks such references ("Plain"): those of a logical
source whose reference formulation is not rml:JSONPath, and every
reference of a mapping written in the legacy vocabulary. The backend writes
them as simple literals. JSON references keep their inferred datatypes:
rml-core stays at 76/76 and rml-fnml unchanged in
scripts/validate_test_cases.py.
---
 src/flexrml/backend/executor/utils.cpp        |  8 ++-
 src/flexrml/backend/executor/utils.h          |  4 ++
 src/flexrml/backend/program/term_program.cpp  |  8 ++-
 .../ra_converter/ra_converter_rml_core.cpp    | 53 ++++++++++++++++---
 src/flexrml/pipeline.cpp                      | 12 ++++-
 5 files changed, 73 insertions(+), 12 deletions(-)

diff --git a/src/flexrml/backend/executor/utils.cpp b/src/flexrml/backend/executor/utils.cpp
index cf89c95..3c78ad0 100644
--- a/src/flexrml/backend/executor/utils.cpp
+++ b/src/flexrml/backend/executor/utils.cpp
@@ -1095,8 +1095,12 @@ void create_operator_into(const std::string& term_map,
     if (is_literal) {
       resolved_lang_tag = resolve_annotation_value(lang_tag, map);
       resolved_data_type = resolve_annotation_value(data_type, map);
-      normalize_iri_annotation(resolved_data_type);
-      resolved_data_type = infer_literal_datatype(rdf_term, resolved_lang_tag, resolved_data_type);
+      if (resolved_data_type == kPlainLiteral) {
+        resolved_data_type = "None";
+      } else {
+        normalize_iri_annotation(resolved_data_type);
+        resolved_data_type = infer_literal_datatype(rdf_term, resolved_lang_tag, resolved_data_type);
+      }
       effective_lang_tag = &resolved_lang_tag;
       effective_data_type = &resolved_data_type;
     }
diff --git a/src/flexrml/backend/executor/utils.h b/src/flexrml/backend/executor/utils.h
index 715320e..797e87e 100644
--- a/src/flexrml/backend/executor/utils.h
+++ b/src/flexrml/backend/executor/utils.h
@@ -31,6 +31,10 @@ void format_statement_into(const std::string& subject, const std::string& predic
 std::string make_safe_iri(std::string_view node, bool encode_non_ascii = true);
 void append_safe_iri(std::string_view node, bool encode_non_ascii, std::string& out);
 bool has_invalid_iri_char(std::string_view value);
+// The datatype annotation of a reference whose values have no natural datatype
+// (a CSV or XML source, a mapping in the legacy vocabulary): a simple literal,
+// never typed from its lexical form (set by the RML-Core frontend).
+inline constexpr std::string_view kPlainLiteral = "Plain";
 std::string_view infer_literal_datatype(std::string_view rdf_term,
                                         std::string_view lang_tag,
                                         std::string_view data_type);
diff --git a/src/flexrml/backend/program/term_program.cpp b/src/flexrml/backend/program/term_program.cpp
index 8bf53ef..7e0799d 100644
--- a/src/flexrml/backend/program/term_program.cpp
+++ b/src/flexrml/backend/program/term_program.cpp
@@ -120,6 +120,7 @@ static CompiledTerm compile_term(const std::vector<std::string>& content,
   term.term_type = content[2];
   term.term_kind = compile_term_type(term.term_type);
   const bool is_literal = term.term_kind == CompiledTermType::Literal;
+  bool plain_literal = false;
   if (is_literal) {
     if (content.size() > 3) {
       term.lang_tag = content[3];
@@ -127,6 +128,11 @@ static CompiledTerm compile_term(const std::vector<std::string>& content,
     if (content.size() > 4) {
       term.data_type = content[4];
     }
+    if (term.data_type == kPlainLiteral) {
+      // a simple literal, without a natural datatype
+      term.data_type = "None";
+      plain_literal = true;
+    }
     if (is_dynamic_annotation(term.lang_tag, projected_header) ||
         is_dynamic_annotation(term.data_type, projected_header)) {
       return term;
@@ -150,7 +156,7 @@ static CompiledTerm compile_term(const std::vector<std::string>& content,
     if (term.reference_index < 0) {
       return CompiledTerm{};
     }
-    term.infer_datatype = is_literal && term.lang_tag == "None" && term.data_type == "None";
+    term.infer_datatype = is_literal && !plain_literal && term.lang_tag == "None" && term.data_type == "None";
   } else if (content[1] == "template") {
     term.map_type = CompiledTermMapType::Template;
     if (!compile_template_parts(term.term_map, projected_header, term.parts)) {
diff --git a/src/flexrml/frontend/ra_converter/ra_converter_rml_core.cpp b/src/flexrml/frontend/ra_converter/ra_converter_rml_core.cpp
index 3c54092..1c81678 100644
