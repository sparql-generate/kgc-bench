+bool uses_legacy_vocabulary(const std::string& rml_string) {
+  return rml_string.find("http://semweb.mmlab.be/ns/rml#") != std::string::npos ||
+         rml_string.find("http://www.w3.org/ns/r2rml#") != std::string::npos;
