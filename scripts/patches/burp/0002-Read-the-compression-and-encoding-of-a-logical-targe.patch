From d54b77bb6ee0f5d926f99dbdd37a473b70c48746 Mon Sep 17 00:00:00 2001
From: Maxime <maxime.lefrancois@emse.fr>
Date: Fri, 27 Nov 2026 01:32:53 +0100
Subject: [PATCH 2/2] Read the compression and encoding of a logical target on
 its target

RML-IO gives rml:compression and rml:encoding the domain rml:Target, and
the test cases RMLTTC0005b and RMLTTC0006b-e (kg-construct/rml-io, since
0cb26a2) put them on the target: BURP read them on the logical target only,
and wrote the dump uncompressed and in UTF-8. They are now read on the
target, else on the logical target as before.
Test: TargetCompressionTest. TestRMLIO and TestRMLCore pass as before.
---
 src/main/java/burp/parse/Parse.java           | 12 ++++-
 src/test/java/burp/TargetCompressionTest.java | 45 +++++++++++++++++++
 2 files changed, 55 insertions(+), 2 deletions(-)
 create mode 100644 src/test/java/burp/TargetCompressionTest.java

diff --git a/src/main/java/burp/parse/Parse.java b/src/main/java/burp/parse/Parse.java
index e572add..17948af 100644
--- a/src/main/java/burp/parse/Parse.java
+++ b/src/main/java/burp/parse/Parse.java
@@ -759,6 +759,11 @@ public class Parse {
         return results;
     }
 
+    private static Resource targetOrLogicalTarget(Resource target, Resource logicalTarget, Property property) {
+        Resource value = target.getPropertyResourceValue(property);
+        return value != null ? value : logicalTarget.getPropertyResourceValue(property);
+    }
+
     private LogicalTarget prepareLogicalTarget(Resource r) {
         if (logicalTargets.containsKey(r)) return logicalTargets.get(r);
 
@@ -778,8 +783,11 @@ public class Parse {
         }
 
         Resource serialization = r.getPropertyResourceValue(RML.serialization);
-        Resource compression = r.getPropertyResourceValue(RML.compression);
-        Resource encoding = r.getPropertyResourceValue(RML.encoding);
+        // RML-IO gives the compression and the encoding to the target (rml:Target, the
+        // domain of rml:compression and rml:encoding); on the logical target, as before,
+        // they are still read
+        Resource compression = targetOrLogicalTarget(targetRes, r, RML.compression);
+        Resource encoding = targetOrLogicalTarget(targetRes, r, RML.encoding);
 
         LogicalTarget lt = new LogicalTarget(target, serialization, compression, encoding);
         logicalTargets.put(r, lt);
diff --git a/src/test/java/burp/TargetCompressionTest.java b/src/test/java/burp/TargetCompressionTest.java
new file mode 100644
index 0000000..db7f1a2
--- /dev/null
+++ b/src/test/java/burp/TargetCompressionTest.java
@@ -0,0 +1,45 @@
+package burp;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * RML-IO gives the compression of a target to the target (rml:Target), as the test cases
+ * RMLTTC0006b-e do since kg-construct/rml-io 0cb26a2; it is still read on the logical target.
+ */
+public class TargetCompressionTest {
+
+    private static final String MAPPING = String.join("\n",
+            "@prefix rml: <http://w3id.org/rml/> .",
+            "@prefix formats: <http://www.w3.org/ns/formats/> .",
+            "<http://example.com/base/TM> a rml:TriplesMap ;",
+            "  rml:logicalSource [ rml:source [ a rml:RelativePathSource ; rml:root rml:MappingDirectory ; rml:path \"people.csv\" ] ;",
+            "      rml:referenceFormulation rml:CSV ] ;",
+            "  rml:subjectMap [ rml:template \"http://example.org/{id}\" ; rml:logicalTarget <http://example.com/base/Dump> ] ;",
+            "  rml:predicateObjectMap [ rml:predicate <http://xmlns.com/foaf/0.1/name> ; rml:objectMap [ rml:reference \"name\" ] ] .",
+            "<http://example.com/base/Dump> a rml:LogicalTarget ;",
+            "  rml:target [ a rml:Target, rml:FilePath ; rml:root rml:CurrentWorkingDirectory ; rml:path \"./dump1.nq.gz\" ;",
+            "      rml:compression rml:gzip ] ;",
+            "  rml:serialization formats:N-Quads .");
+
+    @Test
+    public void testCompressionOnTarget() throws Exception {
+        Path dir = Files.createTempDirectory("burp-target");
+        Files.writeString(dir.resolve("people.csv"), "id,name\n0,Monica\n", StandardCharsets.UTF_8);
+        Path mapping = dir.resolve("mapping.ttl");
+        Files.writeString(mapping, MAPPING, StandardCharsets.UTF_8);
+        Path output = dir.resolve("default.nq");
+        Main.doMain(new String[]{"-m", mapping.toString(), "-o", output.toString()}, dir);
+        try (InputStream in = new GZIPInputStream(Files.newInputStream(dir.resolve("dump1.nq.gz")))) {
+            String nquads = new String(in.readAllBytes(), StandardCharsets.UTF_8);
+            assertTrue(nquads.contains("\"Monica\""), nquads);
+        }
+    }
+}
