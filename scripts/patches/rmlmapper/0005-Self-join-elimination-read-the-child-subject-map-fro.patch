From bd20251da66be56da4f4f6323484ce254836cb5e Mon Sep 17 00:00:00 2001
From: kgc-bench <kgc-bench@invalid>
Date: Fri, 27 Nov 2026 17:15:42 +0100
Subject: [PATCH] Self-join elimination: read the child subject map from the
 child triples map

MappingOptimizer.eliminateSelfJoins, step 3, read the child subject maps from the
parent triples map, so it checked the parent subject a second time and never
applied: a self-join whose child subject uses only the join references ran as a
nested loop (RMLio/rmlmapper-java#288). Test: same-logical-source-with-join-condition4.
---
 .../java/be/ugent/rml/MappingOptimizer.java   |  2 +-
 .../ugent/rml/MappingOptimizationsTest.java   | 21 ++++++++++
 .../mapping.ttl                               | 41 +++++++++++++++++++
 .../output.nt                                 |  3 ++
 .../student.csv                               |  4 ++
 5 files changed, 70 insertions(+), 1 deletion(-)
 create mode 100644 src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/mapping.ttl
 create mode 100644 src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/output.nt
 create mode 100644 src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/student.csv

diff --git a/src/main/java/be/ugent/rml/MappingOptimizer.java b/src/main/java/be/ugent/rml/MappingOptimizer.java
index 3b4b9ac2..f3997e57 100644
--- a/src/main/java/be/ugent/rml/MappingOptimizer.java
+++ b/src/main/java/be/ugent/rml/MappingOptimizer.java
@@ -107,7 +107,7 @@ public class MappingOptimizer {
                                 // if not all references for the parent subject come back in the join conditions,
                                 // 3. check if all references for the related child terms come back in the join conditions
                                 // 3.1 check child subject
-                                List<Term> childSubjectMaps = Utils.getObjectsFromQuads(rmlStore.getQuads(parentTriplesMap, new NamedNode(NAMESPACES.RML2 + "subjectMap"), null));
+                                List<Term> childSubjectMaps = Utils.getObjectsFromQuads(rmlStore.getQuads(childTriplesMap, new NamedNode(NAMESPACES.RML2 + "subjectMap"), null));
                                 if (!childSubjectMaps.isEmpty()) {
                                     safeTerms = hasSafeReferences(childSubjectMaps.get(0), joinReferences);
                                 } else {
diff --git a/src/test/java/be/ugent/rml/MappingOptimizationsTest.java b/src/test/java/be/ugent/rml/MappingOptimizationsTest.java
index 1325c0f0..b10a5a3a 100644
--- a/src/test/java/be/ugent/rml/MappingOptimizationsTest.java
+++ b/src/test/java/be/ugent/rml/MappingOptimizationsTest.java
@@ -1,7 +1,10 @@
 package be.ugent.rml;
 
+import be.ugent.rml.term.NamedNode;
 import org.junit.jupiter.api.Test;
 
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
 public class MappingOptimizationsTest extends TestCore {
 
     @Test
@@ -33,4 +36,22 @@ public class MappingOptimizationsTest extends TestCore {
     public void sameLogicalSourceWithJoinCondition3() {
         doMapping("./mapping-optimizations/same-logical-source-with-join-condition3/mapping.ttl", "./mapping-optimizations/same-logical-source-with-join-condition3/output.nt");
     }
+
+    @Test
+    public void sameLogicalSourceWithJoinCondition4() throws Exception {
+        // the child subject uses only the join reference: the self-join is eliminated
+        String mapping = "./mapping-optimizations/same-logical-source-with-join-condition4/mapping.ttl";
+        Executor executor = this.createExecutor(mapping);
+        assertTrue(executor.getRMLStore().getQuads(null, new NamedNode(NAMESPACES.RML2 + "parentTriplesMap"), null).isEmpty(),
+                "the self-join is not eliminated");
+        doMapping(mapping, "./mapping-optimizations/same-logical-source-with-join-condition4/output.nt");
+    }
+
+    @Test
+    public void sameLogicalSourceWithJoinCondition3KeepsJoin() throws Exception {
+        // neither the parent subject nor the child subject uses only the join reference: the self-join is kept
+        Executor executor = this.createExecutor("./mapping-optimizations/same-logical-source-with-join-condition3/mapping.ttl");
+        assertTrue(!executor.getRMLStore().getQuads(null, new NamedNode(NAMESPACES.RML2 + "parentTriplesMap"), null).isEmpty(),
+                "the self-join is eliminated");
+    }
 }
diff --git a/src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/mapping.ttl b/src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/mapping.ttl
new file mode 100644
index 00000000..0d9ecd27
--- /dev/null
+++ b/src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/mapping.ttl
@@ -0,0 +1,41 @@
+# In this test the referencing object map can be optimized to a 'normal' object map:
+# the subject of the parent triples map uses a reference (ID) that is not in the join condition,
+# but the subject of the child triples map uses only references of the join condition (Sport).
+# The GTFS Madrid Benchmark has this case (shapes and shape points, joined on shape_id).
+
+@prefix ex: <http://example.com/> .
+@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
+@prefix rr: <http://www.w3.org/ns/r2rml#>.
+@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
+@base <http://example.com/base/> .
+
+<TriplesMap1>
+  a rr:TriplesMap;
+
+  rml:logicalSource [
+    rml:source "student.csv";
+    rml:referenceFormulation ql:CSV
+  ];
+
+  rr:subjectMap [ rr:template "http://example.com/Sport/{Sport}" ];
+
+  rr:predicateObjectMap [
+    rr:predicate ex:hasPlayer ;
+    rr:objectMap <RefObjectMap1>
+  ] .
+
+<TriplesMap2>
+  a rr:TriplesMap;
+
+  rml:logicalSource [
+    rml:source "student.csv";
+    rml:referenceFormulation ql:CSV
+  ];
+
+  rr:subjectMap [ rr:template "http://example.com/Student/{ID}" ] .
+
+<RefObjectMap1>
+  a rr:RefObjectMap;
+  rr:parentTriplesMap <TriplesMap2> ;
+  rr:joinCondition [ rr:child "Sport" ;
+      rr:parent "Sport" ] .
diff --git a/src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/output.nt b/src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/output.nt
new file mode 100644
index 00000000..b8c57329
--- /dev/null
+++ b/src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/output.nt
@@ -0,0 +1,3 @@
+<http://example.com/Sport/Tennis> <http://example.com/hasPlayer> <http://example.com/Student/10> .
+<http://example.com/Sport/Tennis> <http://example.com/hasPlayer> <http://example.com/Student/20> .
+<http://example.com/Sport/Figure%20skating> <http://example.com/hasPlayer> <http://example.com/Student/30> .
diff --git a/src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/student.csv b/src/test/resources/mapping-optimizations/same-logical-source-with-join-condition4/student.csv
new file mode 100644
