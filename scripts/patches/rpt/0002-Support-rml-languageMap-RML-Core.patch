 .../rml/jena/impl/TestRmlLanguageMap.java     | 67 +++++++++++++++++++
 2 files changed, 88 insertions(+), 2 deletions(-)
 create mode 100644 rml-jena-arq/src/test/java/org/aksw/rml/jena/impl/TestRmlLanguageMap.java

