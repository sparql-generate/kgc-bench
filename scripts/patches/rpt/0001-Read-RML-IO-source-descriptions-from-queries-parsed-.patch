From: Maxime <maxime.lefrancois@emse.fr>
Date: Thu, 26 Nov 2026 20:56:26 +0100
Subject: [PATCH] Read RML-IO source descriptions from queries parsed from text

"rmltk rml to sparql" writes the source description of a logical source
(rml:RelativePathSource of RML-IO) as a blank node inside the SERVICE
<norse:rml.source> pattern. When the query is read back from its text, as
"rpt integrate queries.rq" does, SPARQL turns that blank node into a blank
node variable: rml:source is then a variable, neither a resource nor a
literal, and the source service fails with "Unsupported logical source".
The JUnit test runners pass Query objects and never see it.

Turn the blank node variables of the service pattern (renamed apart, "?/?0",
in the sub-selects of a join) back into blank nodes
before the source description is read.
---
 .../aksw/rml/jena/service/InitRmlService.java | 31 ++++++++
 .../service/TestRmlSourceFromQueryText.java   | 75 +++++++++++++++++++
 2 files changed, 106 insertions(+)
 create mode 100644 rml-jena-arq/src/test/java/org/aksw/rml/jena/service/TestRmlSourceFromQueryText.java

diff --git a/rml-jena-arq/src/main/java/org/aksw/rml/jena/service/InitRmlService.java b/rml-jena-arq/src/main/java/org/aksw/rml/jena/service/InitRmlService.java
index 09c979c..faaaf36 100644
--- a/rml-jena-arq/src/main/java/org/aksw/rml/jena/service/InitRmlService.java
+++ b/rml-jena-arq/src/main/java/org/aksw/rml/jena/service/InitRmlService.java
@@ -28,6 +28,7 @@ import org.aksw.rmlx.model.RmlXTerms;
 import org.apache.jena.graph.Graph;
 import org.apache.jena.graph.Node;
 import org.apache.jena.graph.NodeFactory;
+import org.apache.jena.graph.Triple;
 import org.apache.jena.query.Query;
 import org.apache.jena.query.ResultSet;
 import org.apache.jena.query.ResultSetFormatter;
@@ -69,6 +70,7 @@ public class InitRmlService {
                 // GraphVar treats variables as constants - so we can navigate the triples of variables
                 Graph graph = new GraphVarImpl();
                 ElementUtils.toGraph(elt, graph);
+                graph = blankNodeVarsToBlankNodes(graph);
                 Model model = ModelFactory.createModelForGraph(graph);
                 // RDFDataMgr.write(System.out, model, RDFFormat.TURTLE_PRETTY);
                 ILogicalSource logicalSource = RmlLib.getOnlyLogicalSource(model);
@@ -80,6 +82,35 @@ public class InitRmlService {
         });
     }
 
+    /**
+     * The blank nodes of a source description, such as the rml:RelativePathSource of
+     * RML-IO, become blank node variables when the generated query is parsed from
+     * its text (in SPARQL, a blank node of a pattern is a variable), renamed apart
+     * inside a sub-select (a join of two triples maps). Turn them back
+     * into blank nodes, so that the description reads the same whether the query
+     * was built in memory or parsed from its serialization.
+     */
+    public static Graph blankNodeVarsToBlankNodes(Graph graph) {
+        Graph result = new GraphVarImpl();
+        graph.find().forEach(t -> result.add(Triple.create(
+                blankNodeVarToBlankNode(t.getSubject()),
+                blankNodeVarToBlankNode(t.getPredicate()),
+                blankNodeVarToBlankNode(t.getObject()))));
+        return result;
+    }
+
+    static Node blankNodeVarToBlankNode(Node node) {
+        if (!node.isVariable()) {
+            return node;
+        }
+        // in a sub-select, the variable is also renamed apart ("?/?0")
+        String name = node.getName();
+        while (name.startsWith("/")) {
+            name = name.substring(1);
+        }
+        return Var.isBlankNodeVarName(name) ? NodeFactory.createBlankNode(name) : node;
+    }
+
     public static void initRegistryRml1(Map<String, RmlSourceProcessor> registry) {
         registry.put(QlTerms.CSV, RmlSourceProcessorCsv.getInstance());
         registry.put(QlTerms.JSONPath, InitRmlService::processSourceAsJson);
diff --git a/rml-jena-arq/src/test/java/org/aksw/rml/jena/service/TestRmlSourceFromQueryText.java b/rml-jena-arq/src/test/java/org/aksw/rml/jena/service/TestRmlSourceFromQueryText.java
new file mode 100644
index 0000000..a67abb0
--- /dev/null
+++ b/rml-jena-arq/src/test/java/org/aksw/rml/jena/service/TestRmlSourceFromQueryText.java
@@ -0,0 +1,75 @@
+package org.aksw.rml.jena.service;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import org.apache.jena.query.Query;
+import org.apache.jena.query.QueryExecutionFactory;
+import org.apache.jena.query.QueryFactory;
+import org.apache.jena.rdf.model.Model;
+import org.apache.jena.rdf.model.ModelFactory;
+import org.apache.jena.rdf.model.ResourceFactory;
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * A query generated by "rmltk rml to sparql" is written as text and read back by
+ * "integrate": the blank node of its RML-IO source description
+ * (rml:RelativePathSource) is then a blank node variable, and must still be read
+ * as the source of the logical source.
+ */
+public class TestRmlSourceFromQueryText {
+
+    static final String QUERY = String.join("\n",
+        "CONSTRUCT { ?v4 <http://xmlns.com/foaf/0.1/name> ?v0 . }",
+        "WHERE",
+        "  { SERVICE <https://w3id.org/aksw/norse#rml.source>",
+        "      { <https://w3id.org/aksw/norse#rml.source>",
+        "                  a <http://w3id.org/rml/LogicalSource> ;",
+        "                  <http://w3id.org/rml/iterator> \"$.students[*]\" ;",
+        "                  <http://w3id.org/rml/referenceFormulation> <http://w3id.org/rml/JSONPath> .",
+        "        _:b0      a <http://w3id.org/rml/RelativePathSource> ;",
+        "                  <http://w3id.org/rml/root> <http://w3id.org/rml/CurrentWorkingDirectory> ;",
+        "                  <http://w3id.org/rml/path> \"%s\" .",
+        "        <https://w3id.org/aksw/norse#rml.source>",
+        "                  <http://w3id.org/rml/source> _:b0 ;",
+        "                  <https://w3id.org/aksw/norse#rml.output> ?s0 }",
+        "    BIND(<https://w3id.org/aksw/norse#json.path>(?s0, \"$.Name\") AS ?v0)",
+        "    BIND(<https://w3id.org/aksw/norse#rml.iri>(concat(\"http://example.com/\", encode_for_uri(str(?v0)))) AS ?v4)",
+        "  }");
+
+    /** The same pattern in a sub-select, as "rml to sparql" writes the two sides of a join. */
+    static final String SUBQUERY = QUERY
+        .replace("WHERE\n  { SERVICE", "WHERE\n  { { SELECT ?v4 ?v0 WHERE { SERVICE")
+        .replace("AS ?v4)\n  }", "AS ?v4) } } }");
+
+    @Test
+    public void testRelativePathSourceInParsedSubQuery() throws Exception {
+        Path json = Files.createTempFile("student", ".json");
+        try {
+            Files.writeString(json, "{ \"students\": [ { \"Name\": \"Venus\" } ] }", StandardCharsets.UTF_8);
+            Query query = QueryFactory.create(String.format(SUBQUERY, json.toAbsolutePath()));
+            Model actual = QueryExecutionFactory.create(query, ModelFactory.createDefaultModel()).execConstruct();
+            Assert.assertEquals(1, actual.size());
+        } finally {
+            Files.deleteIfExists(json);
+        }
+    }
+
+    @Test
+    public void testRelativePathSourceInParsedQuery() throws Exception {
+        Path json = Files.createTempFile("student", ".json");
+        try {
+            Files.writeString(json, "{ \"students\": [ { \"Name\": \"Venus\" } ] }", StandardCharsets.UTF_8);
+            Query query = QueryFactory.create(String.format(QUERY, json.toAbsolutePath()));
+            Model actual = QueryExecutionFactory.create(query, ModelFactory.createDefaultModel()).execConstruct();
+            Model expected = ModelFactory.createDefaultModel();
+            expected.add(expected.createResource("http://example.com/Venus"),
+                    ResourceFactory.createProperty("http://xmlns.com/foaf/0.1/name"), "Venus");
+            Assert.assertTrue(actual.isIsomorphicWith(expected));
+        } finally {
+            Files.deleteIfExists(json);
+        }
+    }
+}
