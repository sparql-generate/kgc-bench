From c9613f86e20bdd75a2d58c1d7a1ea6d79a4a5884 Mon Sep 17 00:00:00 2001
From: Maxime <maxime.lefrancois@emse.fr>
Date: Thu, 26 Nov 2026 21:25:38 +0100
Subject: [PATCH] Fix join conditions with template or constant child and
 parent maps

Since 4.7.5.15, the join values of a referencing object map are made
unique with dict.fromkeys, which fails when a child or parent map is a
template or a constant, kept as a dict: "TypeError: unhashable type:
'dict'" while parsing the mapping. The RML-Core test cases RMLTC0030b-f
(kg-construct/rml-core) stop on it; 4.7.5.14 passed them.

Make the values unique by equality instead.
---
 rdfizer/rdfizer/__init__.py                   |   6 +-
 rdfizer/rdfizer/functions.py                  |  10 +++
 .../test_join_term_maps.cpython-312.pyc       | Bin 0 -> 4623 bytes
 rdfizer/tests/test_join_term_maps.py          |  65 ++++++++++++++++++
 4 files changed, 78 insertions(+), 3 deletions(-)
 create mode 100644 rdfizer/tests/__pycache__/test_join_term_maps.cpython-312.pyc
 create mode 100644 rdfizer/tests/test_join_term_maps.py

diff --git a/rdfizer/rdfizer/__init__.py b/rdfizer/rdfizer/__init__.py
index 9df88c3..476ee97 100755
--- a/rdfizer/rdfizer/__init__.py
+++ b/rdfizer/rdfizer/__init__.py
@@ -3528,9 +3528,9 @@ def mapping_parser(mapping_file):
                                 predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)][
                                 "parents"].append(str(result_predicate_object_map.parent_value))
                     join = False
-                    if len(list(dict.fromkeys(join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["parents"]))) == 1 and len(list(dict.fromkeys(join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["childs"]))) == 1:
-                        join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["childs"] = list(dict.fromkeys(join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["childs"]))
-                        join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["parents"] = list(dict.fromkeys(join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["parents"]))
+                    if len(unique_join_values(join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["parents"])) == 1 and len(unique_join_values(join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["childs"])) == 1:
+                        join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["childs"] = unique_join_values(join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["childs"])
+                        join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["parents"] = unique_join_values(join_predicate[predicate_map.value + " " + str(result_predicate_object_map.object_parent_triples_map)]["parents"])
 
                 elif result_predicate_object_map.function is not None:
                     #for var, val in zip(mapping_query_prepared_results.vars, result_predicate_object_map):
diff --git a/rdfizer/rdfizer/functions.py b/rdfizer/rdfizer/functions.py
index 174cecd..3ad6d4a 100644
--- a/rdfizer/rdfizer/functions.py
+++ b/rdfizer/rdfizer/functions.py
@@ -566,6 +566,16 @@ def turtle_print(subject, predicate, object, object_list, duplicate_type, predic
 			output_file_descriptor.write(subject + " " + predicate + " " + object + ".\n\n")
 			return "."
 
+def unique_join_values(values):
+	"""The join values of a referencing object map without repetition, in order. A
+	child or parent map that is a template or a constant is a dict, which
+	dict.fromkeys cannot hash (RMLTC0030b-f, kg-construct/rml-core)."""
+	unique = []
+	for value in values:
+		if value not in unique:
+			unique.append(value)
+	return unique
+
 def extract_base(file):
 	base = ""
 	f = open(file,"r")
