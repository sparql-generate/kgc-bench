diff --git a/rdfizer/tests/test_join_term_maps.py b/rdfizer/tests/test_join_term_maps.py
new file mode 100644
index 0000000..fde7e08
--- /dev/null
+++ b/rdfizer/tests/test_join_term_maps.py
@@ -0,0 +1,65 @@
+"""A join condition whose child and parent maps are templates (rml:childMap,
+rml:parentMap of RML-Core; test cases RMLTC0030b-f, kg-construct/rml-core).
+
+    python -m unittest discover -s tests
+"""
+
+import os
+import tempfile
+import unittest
+
+from rdfizer import semantify
+
+MAPPING = """@prefix rml: <http://w3id.org/rml/> .
+@prefix ex: <http://example.com/ontology/> .
+
+<http://example.com/base/TriplesMap1> a rml:TriplesMap;
+  rml:logicalSource [ a rml:LogicalSource; rml:referenceFormulation rml:JSONPath; rml:iterator "$.students[*]";
+      rml:source [ a rml:RelativePathSource; rml:root rml:MappingDirectory; rml:path "student.json" ] ];
+  rml:subjectMap [ rml:template "http://example.com/student/{$.ID}" ];
+  rml:predicateObjectMap [ rml:predicate ex:practises;
+      rml:objectMap [ a rml:RefObjectMap;
+          rml:parentTriplesMap <http://example.com/base/TriplesMap2>;
+          rml:joinCondition [
+              rml:childMap [ rml:template "http://example.com/{$.Sport}" ];
+              rml:parentMap [ rml:template "http://example.com/{$.ID}" ] ] ] ] .
+
+<http://example.com/base/TriplesMap2> a rml:TriplesMap;
+  rml:logicalSource [ a rml:LogicalSource; rml:referenceFormulation rml:JSONPath; rml:iterator "$.sports[*]";
+      rml:source [ a rml:RelativePathSource; rml:root rml:MappingDirectory; rml:path "sport.json" ] ];
+  rml:subjectMap [ rml:template "http://example.com/sport/{$.ID}" ] .
+"""
+
+
+def run():
+    d = tempfile.mkdtemp()
+    with open(os.path.join(d, "student.json"), "w") as f:
+        f.write('{"students": [{"ID": 10, "Sport": 100}, {"ID": 20}]}')
+    with open(os.path.join(d, "sport.json"), "w") as f:
+        f.write('{"sports": [{"ID": 100, "Name": "Tennis"}]}')
+    with open(os.path.join(d, "mapping.ttl"), "w") as f:
+        f.write(MAPPING)
+    out = os.path.join(d, "out")
+    with open(os.path.join(d, "config.ini"), "w") as f:
+        f.write("[default]\nmain_directory: %s\n\n[datasets]\nnumber_of_datasets: 1\n"
+                "output_folder: %s\nall_in_one_file: no\nremove_duplicate: yes\nenrichment: yes\n"
+                "name: out\nordered: no\nlarge_file: false\nnew_formulation: yes\n\n"
+                "[dataset1]\nname: out\nmapping: %s\n" % (d, out, os.path.join(d, "mapping.ttl")))
+    cwd = os.getcwd()
+    os.chdir(d)
+    try:
+        semantify(os.path.join(d, "config.ini"))
+    finally:
+        os.chdir(cwd)
+    return open(os.path.join(out, "out.nt")).read()
+
+
+class JoinTermMaps(unittest.TestCase):
+    def test_template_child_and_parent_maps(self):
+        output = run()
+        self.assertIn("<http://example.com/student/10> <http://example.com/ontology/practises> "
+                      "<http://example.com/sport/100>", output)
+
+
+if __name__ == "__main__":
+    unittest.main()
