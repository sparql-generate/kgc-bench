From 600495191bb739e57631a9bea677cfd289a3b93c Mon Sep 17 00:00:00 2001
From: Maxime <maxime.lefrancois@emse.fr>
Date: Fri, 27 Nov 2026 01:02:17 +0100
Subject: [PATCH] Write N-Quads a chunk of lines at a time

With toRDF, parseFile built the whole N-Quads output as one string. A large
output is longer than the longest string of V8 (2^29 characters): on
GTFS-Madrid-Bench at scale 10 (4 million quads), jsonld.toRDF fails with
"RangeError: Invalid string length".

The quads of jsonld.toRDF are now serialized one by one (jsonld's NQuads,
sorted as before) and written to the file a chunk of lines at a time; the
N-Quads string is still returned when it fits in one string. Test: N-Quads
written line by line.
---
 src/index.js  | 41 +++++++++++++++++++++++++++++++++++------
 tests/test.js |  8 ++++++++
 2 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/src/index.js b/src/index.js
index 09b0036..70f5a0e 100644
--- a/src/index.js
+++ b/src/index.js
@@ -1,5 +1,6 @@
 const fs = require('fs');
 const jsonld = require('jsonld');
+const NQuads = require('jsonld/lib/NQuads');
 const mapfile = require('./mapfile/mapfileParser');
 const logicalSource = require('./input-parser/logicalSourceParser');
 const parser = require('./input-parser/parser');
@@ -26,10 +27,30 @@ const markStringDoubles = (node) => {
   }
 };
 
-const toRDF = async (out) => {
+// The N-Quads lines of the output, sorted as jsonld.toRDF sorts them. A list of
+// lines rather than one string: the N-Quads of a large output (GTFS-Madrid-Bench at
+// scale 10, 4 million quads) are longer than the longest string of V8 (2^29 characters,
+// "RangeError: Invalid string length").
+const toNQuadsLines = async (out) => {
   markStringDoubles(out);
-  const rdf = await jsonld.toRDF(out, { format: 'application/n-quads' });
-  return rdf.split(`^^<${KEPT_DOUBLE}>`).join(`^^<${XSD_DOUBLE}>`);
+  const dataset = await jsonld.toRDF(out);
+  return dataset
+    .map((quad) => NQuads.serializeQuad(quad).split(`^^<${KEPT_DOUBLE}>`).join(`^^<${XSD_DOUBLE}>`))
+    .sort();
+};
+
+const toRDF = async (out) => (await toNQuadsLines(out)).join('');
+
+// Write the lines to a file a chunk at a time.
+const writeLines = (path, lines) => {
+  const fd = fs.openSync(path, 'w');
+  try {
+    for (let i = 0; i < lines.length; i += 10000) {
+      fs.writeSync(fd, lines.slice(i, i + 10000).join(''));
+    }
+  } finally {
+    fs.closeSync(fd);
+  }
 };
 
 const parseFile = async (pathInput, pathOutput, options = {}) => {
@@ -40,10 +61,18 @@ const parseFile = async (pathInput, pathOutput, options = {}) => {
   const output = await process(res, options);
   const out = await clean(output, options);
   if (options && options.toRDF && options.toRDF === true) {
-    const rdf = await toRDF(out);
+    const lines = await toNQuadsLines(out);
     helper.consoleLogIf(`Writing to ${pathOutput}`, options);
-    fs.writeFileSync(pathOutput, rdf);
-    return rdf;
+    writeLines(pathOutput, lines);
+    try {
+      return lines.join('');
+    } catch (e) {
+      if (e instanceof RangeError) {
+        // too long for one string: the output is in the file only
+        return undefined;
+      }
+      throw e;
+    }
   }
   helper.consoleLogIf(`Writing to ${pathOutput}`, options);
   fs.writeFileSync(pathOutput, JSON.stringify(out, null, 2));
diff --git a/tests/test.js b/tests/test.js
index d3baaaa..3e65251 100644
--- a/tests/test.js
+++ b/tests/test.js
@@ -1,3 +1,4 @@
+const fs = require('fs');
 const assert = require('assert');
 
 const parser = require('..');
@@ -831,6 +832,13 @@ it('xsd:double keeps the lexical form of the data', async () => {
   ]);
 });
 
+it('N-Quads written line by line', async () => {
+  // the file holds the returned N-Quads, written in chunks of lines
+  const result = await parser.parseFile('./tests/doubleLexicalForm/mapping.ttl', './tests/doubleLexicalForm/out.nq', { toRDF: true });
+  assert.equal(fs.readFileSync('./tests/doubleLexicalForm/out.nq', 'utf8'), result);
+  assert.equal(result.split('\n').filter((l) => l).length, 2);
+});
+
 it('subject as functionMapping', async () => {
   let i = 0;
   const options = {
