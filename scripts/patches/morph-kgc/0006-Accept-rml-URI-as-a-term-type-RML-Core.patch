Date: Fri, 27 Nov 2026 00:59:58 +0100
Subject: [PATCH 6/8] Accept rml:URI as a term type (RML-Core)

RML-Core keeps rml:URI as a synonym of rml:IRI. A term map with
rml:termType rml:URI stopped the mapping ("Invalid subject termtype(s)"), as
in RMLTC0027a (kg-construct/rml-core). It is now normalized to rml:IRI.
Test: test/uri-term-type (RMLTC0027a-JSON).
---
 src/morph_kgc/mapping/normalizer.py      | 15 +++++++++++++++
 test/uri-term-type/mapping.ttl           | 21 +++++++++++++++++++++
 test/uri-term-type/output.nq             |  5 +++++
 test/uri-term-type/student.json          |  9 +++++++++
 test/uri-term-type/test_uri_term_type.py | 23 +++++++++++++++++++++++
 5 files changed, 73 insertions(+)
 create mode 100644 test/uri-term-type/mapping.ttl
 create mode 100644 test/uri-term-type/output.nq
 create mode 100644 test/uri-term-type/student.json
 create mode 100644 test/uri-term-type/test_uri_term_type.py

diff --git a/src/morph_kgc/mapping/normalizer.py b/src/morph_kgc/mapping/normalizer.py
index bbe01d7..8060c4c 100644
--- a/src/morph_kgc/mapping/normalizer.py
+++ b/src/morph_kgc/mapping/normalizer.py
@@ -8,6 +8,7 @@ __license__ = "Apache-2.0"
 import rdflib
 
 from ..constants import (
+    RML_NAMESPACE,
     RDF_REIFIES,
     RML_TRIPLES_MAP_CLASS,
     RML_NON_ASSERTED_TRIPLES_MAP_CLASS,
@@ -420,6 +421,19 @@ def _normalize_template_placeholders(mapping_graph: rdflib.Graph) -> rdflib.Grap
 # Validation
 # ---------------------------------------------------------------------------
 
+def normalize_uri_termtype(mapping_graph: rdflib.Graph) -> rdflib.Graph:
+    """
+    Replace the term type ``rml:URI``, a synonym of ``rml:IRI`` in RML-Core, by
+    ``rml:IRI``.
+    """
+    term_type = rdflib.URIRef(RML_TERM_TYPE)
+    uri = rdflib.URIRef(RML_NAMESPACE + 'URI')
+    for term_map in list(mapping_graph.subjects(term_type, uri)):
+        mapping_graph.remove((term_map, term_type, uri))
+        mapping_graph.add((term_map, term_type, rdflib.URIRef(RML_IRI)))
+    return mapping_graph
+
+
 def validate_termtypes(mapping_graph: rdflib.Graph) -> None:
     """
     Raise ``ValueError`` if any term map has an illegal termtype.
@@ -466,6 +480,7 @@ def normalize_mapping_graph(mapping_graph: rdflib.Graph) -> rdflib.Graph:
 
     Returns the mutated graph.
     """
+    mapping_graph = normalize_uri_termtype(mapping_graph)
     mapping_graph = rdf_class_to_pom(mapping_graph)
     mapping_graph = expand_shortcuts(mapping_graph)
     mapping_graph = subject_graph_maps_to_pom(mapping_graph)
