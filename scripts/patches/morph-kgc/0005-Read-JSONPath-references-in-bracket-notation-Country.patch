From d38f012445f077ba2d215b141756743f53bc2134 Mon Sep 17 00:00:00 2001
From: Maxime <maxime.lefrancois@emse.fr>
Date: Fri, 27 Nov 2026 00:58:45 +0100
Subject: [PATCH 5/8] Read JSONPath references in bracket notation ($['Country
 Code'])

A JSON reference written in the bracket notation of JSONPath, as RML-Core
does for a field name with a space ({$['Country Code']} in RMLTC0010a-c,
kg-construct/rml-core), selected nothing: strip_json_root removed the "$."
prefix only. The bracket notation of a field is now read as its name.
Test: test/json-bracket-references (RMLTC0010c-JSON).
---
 src/morph_kgc/source/file.py                  | 16 ++++++++++---
 .../json-bracket-references/country_info.json | 15 ++++++++++++
 test/json-bracket-references/mapping.ttl      | 22 +++++++++++++++++
 test/json-bracket-references/output.nq        |  4 ++++
 .../test_json_bracket_references.py           | 24 +++++++++++++++++++
 5 files changed, 78 insertions(+), 3 deletions(-)
 create mode 100644 test/json-bracket-references/country_info.json
 create mode 100644 test/json-bracket-references/mapping.ttl
 create mode 100644 test/json-bracket-references/output.nq
 create mode 100644 test/json-bracket-references/test_json_bracket_references.py

diff --git a/src/morph_kgc/source/file.py b/src/morph_kgc/source/file.py
index 6028c3c..ce43eef 100644
--- a/src/morph_kgc/source/file.py
+++ b/src/morph_kgc/source/file.py
@@ -18,6 +18,7 @@ from typing import Any
 
 import duckdb
 import json
+import re
 import pandas as pd
 import urllib.request
 import xml.etree.ElementTree as et
@@ -121,12 +122,21 @@ def _read_ods(rml_rule, references: list[str]) -> pd.DataFrame:
     )
 
 
+_JSON_ROOT_BRACKET = re.compile(r"""^\$\[(['"])(.+)\1\]$""")
+
+
 def strip_json_root(reference: str) -> str:
     """
-    Removes the leading `$.` of a JSONPath reference. References are evaluated relative to the
-    iterator, so `$.name` and `name` select the same field (RML-Core writes references as `$.name`).
+    Removes the leading `$.` of a JSONPath reference, or its bracket notation (`$['name']`).
+    References are evaluated relative to the iterator, so `$.name`, `$['name']` and `name`
+    select the same field (RML-Core writes references as `$.name`, and `$['Country Code']` for
+    a field name with a space).
     """
-    return reference[2:] if reference.startswith('$.') else reference
+    if reference.startswith('$.'):
+        return reference[2:]
+    # the bracket notation of a field: $['Country Code'] or $["Country Code"]
+    bracket = _JSON_ROOT_BRACKET.match(reference)
+    return bracket.group(2) if bracket else reference
 
 
 def alias_json_root_references(json_df: pd.DataFrame, references: list[str]) -> pd.DataFrame:
