@@ -54,6 +54,48 @@ MORPH_FN_SPARQL_QUERY        = f"{MORPH_FUNCTION_NAMESPACE}sparqlQuery"
 GREL_VALUE_PARAM        = f"{GREL_NAMESPACE}valueParam"
 GREL_VALUE_PARAMETER    = f"{GREL_NAMESPACE}valueParameter"
 
