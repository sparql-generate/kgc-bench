+
 import rdflib
 
 from ...constants import (
@@ -31,6 +33,8 @@ from ...constants import (
     FNML_RETURN_SHORTCUT,      RML_RETURN_SHORTCUT,
     FNML_PARAMETER_SHORTCUT,   RML_PARAMETER_SHORTCUT,
     FNML_VALUE_SHORTCUT,       RML_VALUE_SHORTCUT,
