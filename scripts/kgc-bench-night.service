# Copy, with kgc-bench-night.timer, to ~/.config/systemd/user/, set the path
# of the clone below, then: systemctl --user daemon-reload &&
# systemctl --user enable --now kgc-bench-night.timer
[Unit]
Description=kgc-bench: the planned measurement campaign, on a quiet machine

[Service]
Type=oneshot
WorkingDirectory=%h/kgc-bench
ExecStart=/bin/sh scripts/night.sh
Nice=0
